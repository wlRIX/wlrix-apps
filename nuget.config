<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Local patched Avalonia.Wayland until the fixes land upstream, plus the wlRIX
         Avalonia theme and dialogs. Built from the Avalonia fork's `wlrix-12.1.0` branch
         (upstream's 12.1.0 tag + the wlRIX patches); see README, "Rebuilding the localfeed".

         The version carries a `-wlrix.N` suffix on purpose. Upstream has since published a
         real Avalonia.Wayland 12.1.1 to nuget.org, and a local package sharing an id and
         version with a published one is a coin toss: whichever source answers first wins,
         and on CI, where localfeed is gitignored and absent, it is always upstream's,
         which has none of these patches. A suffix upstream will never use cannot collide. -->
        <add key="wlrix-local" value="localfeed" />
    </packageSources>
</configuration>
