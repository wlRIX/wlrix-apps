<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Wlrix.Settings.International\Wlrix.Settings.International.csproj" />
        <ProjectReference Include="..\..\src\Wlrix.Settings.International.Core\Wlrix.Settings.International.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <!-- Small cuts of the real system files the parsers read; see each file's first lines. -->
        <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- The markup and the catalog as data, for LocalizationTests. Copied by hand rather than as
         None items, because Avalonia's build claims every *.axaml as AvaloniaXaml and removes it
         from None again. -->
    <Target Name="CopyLocalizationData" BeforeTargets="Build">
        <ItemGroup>
            <LocalizationData Include="$(MSBuildThisFileDirectory)..\..\src\Wlrix.Settings.International\Views\*.axaml" />
            <LocalizationData Include="$(MSBuildThisFileDirectory)..\..\src\Wlrix.Settings.International\Localization\*.resx" />
            <LocalizationData Include="$(MSBuildThisFileDirectory)..\..\src\Wlrix.Settings.International\Localization\Strings.cs" />
        </ItemGroup>
        <Copy SourceFiles="@(LocalizationData)"
              DestinationFolder="$(OutDir)Localization"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
