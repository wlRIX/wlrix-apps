<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Wlrix.FilePicker\Wlrix.FilePicker.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The catalogs as data, so a test reads what the application actually ships rather
             than a copy of it. A missing key renders as the key itself, silently and at
             runtime only. -->
        <None Include="..\..\src\Wlrix.FilePicker\Localization\*.resx"
              Link="Localization\%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- The markup is copied by hand rather than as a None item, because Avalonia's build
         claims every *.axaml as AvaloniaXaml and removes it from None again — which copies
         nothing, silently, and leaves the localization test scanning an empty directory. A
         Copy task owns no item type and nothing takes it back. -->
    <Target Name="CopyMarkupForLocalizationTests" BeforeTargets="Build">
        <ItemGroup>
            <LocalizationMarkup Include="$(MSBuildThisFileDirectory)..\..\src\Wlrix.FilePicker\Views\*.axaml" />
        </ItemGroup>
        <Copy SourceFiles="@(LocalizationMarkup)"
              DestinationFolder="$(OutDir)Localization"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
