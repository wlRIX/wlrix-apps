<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-settings-keyboard</AssemblyName>
        <Version>0.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <!-- Everything about the config file goes through wlrix-settings-daemon. This app used
             to carry its own TOML editor and its own libc kill() for the SIGHUP; both are gone,
             and with them the AllowUnsafeBlocks that only existed for the P/Invoke stub. -->
        <ProjectReference Include="../Wlrix.Settings.Client/Wlrix.Settings.Client.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Follows the session's color scheme, so this window is the same gray as the desktop
             behind it and stays that way when somebody changes it. One call in App.axaml.cs. -->
        <ProjectReference Include="../Wlrix.Theme/Wlrix.Theme.csproj" />
    </ItemGroup>

</Project>
