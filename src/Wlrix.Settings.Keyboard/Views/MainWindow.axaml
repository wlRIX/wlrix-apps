<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.Settings.Keyboard.ViewModels"
        xmlns:svc="using:Wlrix.Settings.Keyboard.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="440"
        Width="380" Height="440"
        x:Class="Wlrix.Settings.Keyboard.Views.MainWindow"
        x:DataType="vm:KeyboardSettingsViewModel"
        CanResize="False"
        Title="Keyboard Settings">

    <Design.DataContext>
        <vm:KeyboardSettingsViewModel />
    </Design.DataContext>

    <StackPanel Margin="12" Spacing="12">

        <!-- Title banner: icon slot plus the panel name, as on the IRIX original. -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="48" Height="48"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource WlrixOuterLine}"
                    Background="{DynamicResource WlrixSelect}">
                <!-- Placeholder for the keyboard icon (a real asset comes from wlrix-assets). -->
                <TextBlock Text="&#x2328;" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Keyboard Settings" FontWeight="Bold" FontSize="16"
                       VerticalAlignment="Center" />
        </StackPanel>

        <CheckBox Content="Key Repeat" IsChecked="{Binding RepeatEnabled}" />

        <!-- Repeat speed/delay: slider on the left, label on the right; each slider's current
             value shows in its tooltip. Disabled together with Key Repeat. -->
        <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0"
                    Minimum="1" Maximum="100"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding RepeatRate}"
                    IsEnabled="{Binding RepeatEnabled}"
                    ToolTip.Tip="{Binding RepeatRateText}" />
            <TextBlock Grid.Column="1" Text="Repeat Speed"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0"
                    Minimum="100" Maximum="1000"
                    TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding RepeatDelay}"
                    IsEnabled="{Binding RepeatEnabled}"
                    ToolTip.Tip="{Binding RepeatDelayText}" />
            <TextBlock Grid.Column="1" Text="Repeat Delay"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <!-- Layout and model selectors, ahead of the test field. -->
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Layout" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:XkbEntry">
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Model" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:XkbEntry">
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Live test field: typing here uses whatever settings were last committed. -->
        <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="Test:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
            <Button Content="Close" Click="OnClose" />
            <Button Content="Reset" Click="OnReset" />
            <Button Content="Help">
                <Button.Flyout>
                    <Flyout>
                        <TextBlock MaxWidth="260" TextWrapping="Wrap"
                                   Text="Adjust the key repeat speed and delay, and pick a keyboard layout and model. Changes apply as you make them; type in the Test box to try them. Reset restores the settings from when this window opened." />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

    </StackPanel>

</Window>
