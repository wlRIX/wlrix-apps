<Window xmlns="https://github.com/avaloniaui"
        xmlns:wt="using:Wlrix.Theme"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.Settings.Keyboard.ViewModels"
        xmlns:loc="using:Wlrix.Common.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="440"
        Width="380" Height="440"
        x:Class="Wlrix.Settings.Keyboard.Views.MainWindow"
        x:DataType="vm:KeyboardSettingsViewModel"
        CanResize="False"
        Title="{loc:Tr WindowTitle}">

    <Design.DataContext>
        <vm:KeyboardSettingsViewModel />
    </Design.DataContext>

    <StackPanel Margin="12" Spacing="12">

        <!-- Title banner: icon slot plus the panel name, as on the IRIX original. -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="48" Height="48"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource WlrixOuterLine}"
                    Background="{DynamicResource WlrixReadWritePanel}">
                <!-- The panel's own icon on the closed control panel carpet, as IRIX drew it here.
                     The picture is tools/panel-banners.py's. -->
                <wt:IrixPicture Width="46" Height="46"
                                Asset="avares://wlrix-settings-keyboard/Assets/banner.svg" />
            </Border>
            <TextBlock Text="{loc:Tr PanelTitle}" FontWeight="Bold" FontSize="16"
                       VerticalAlignment="Center" />
        </StackPanel>

        <CheckBox Content="{loc:Tr KeyRepeat}" IsChecked="{Binding RepeatEnabled}" />

        <!-- Repeat speed/delay: slider on the left, label on the right; each slider's current
             value shows in its tooltip. Disabled together with Key Repeat. -->
        <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0"
                    Minimum="1" Maximum="100"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding RepeatRate}"
                    IsEnabled="{Binding RepeatEnabled}"
                    ToolTip.Tip="{Binding RepeatRateText}" />
            <TextBlock Grid.Column="1" Text="{loc:Tr RepeatSpeed}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0"
                    Minimum="100" Maximum="1000"
                    TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding RepeatDelay}"
                    IsEnabled="{Binding RepeatEnabled}"
                    ToolTip.Tip="{Binding RepeatDelayText}" />
            <TextBlock Grid.Column="1" Text="{loc:Tr RepeatDelay}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <!-- The layout and the keyboard model are chosen in the International panel, with the
             country, language and time zone, as IRIX's ipanel did. This opens it at its Keyboard
             dialog. -->
        <Grid ColumnDefinitions="*,8,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Tr LayoutElsewhere}" TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="{loc:Tr LayoutButton}" Click="OnLayout" />
        </Grid>

        <!-- Live test field: typing here uses whatever settings were last committed. -->
        <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="{loc:Tr Test}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" />
        </Grid>

        <!-- What became of the last change, when it is worth saying: the compositor not being
             running, a value the daemon refused, or a config file somebody has half-edited.
             Empty, and so invisible, when everything applied. -->
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
            <Button Content="{loc:Tr Close}" Click="OnClose" />
            <Button Content="{loc:Tr Reset}" Click="OnReset" />
            <Button Content="{loc:Tr Help}">
                <Button.Flyout>
                    <Flyout>
                        <TextBlock MaxWidth="260" TextWrapping="Wrap"
                                   Text="{loc:Tr HelpText}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

    </StackPanel>

</Window>
