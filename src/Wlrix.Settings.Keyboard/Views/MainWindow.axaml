<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.Settings.Keyboard.ViewModels"
        xmlns:svc="using:Wlrix.Settings.Keyboard.Services"
        xmlns:loc="using:Wlrix.Common.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="440"
        Width="380" Height="440"
        x:Class="Wlrix.Settings.Keyboard.Views.MainWindow"
        x:DataType="vm:KeyboardSettingsViewModel"
        CanResize="False"
        Title="{loc:Tr WindowTitle}">

    <Design.DataContext>
        <vm:KeyboardSettingsViewModel />
    </Design.DataContext>

    <StackPanel Margin="12" Spacing="12">

        <!-- Title banner: icon slot plus the panel name, as on the IRIX original. -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="48" Height="48"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource WlrixOuterLine}"
                    Background="{DynamicResource WlrixSelect}">
                <!-- Placeholder for the keyboard icon (a real asset comes from wlrix-assets). -->
                <TextBlock Text="&#x2328;" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{loc:Tr PanelTitle}" FontWeight="Bold" FontSize="16"
                       VerticalAlignment="Center" />
        </StackPanel>

        <CheckBox Content="{loc:Tr KeyRepeat}" IsChecked="{Binding RepeatEnabled}" />

        <!-- Repeat speed/delay: slider on the left, label on the right; each slider's current
             value shows in its tooltip. Disabled together with Key Repeat. -->
        <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0"
                    Minimum="1" Maximum="100"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding RepeatRate}"
                    IsEnabled="{Binding RepeatEnabled}"
                    ToolTip.Tip="{Binding RepeatRateText}" />
            <TextBlock Grid.Column="1" Text="{loc:Tr RepeatSpeed}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0"
                    Minimum="100" Maximum="1000"
                    TickFrequency="10" IsSnapToTickEnabled="True"
                    Value="{Binding RepeatDelay}"
                    IsEnabled="{Binding RepeatEnabled}"
                    ToolTip.Tip="{Binding RepeatDelayText}" />
            <TextBlock Grid.Column="1" Text="{loc:Tr RepeatDelay}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <!-- Layout and model selectors, ahead of the test field. -->
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Layout}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:XkbEntry">
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Model}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:XkbEntry">
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Live test field: typing here uses whatever settings were last committed. -->
        <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="{loc:Tr Test}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" />
        </Grid>

        <!-- What became of the last change, when it is worth saying: the compositor not being
             running, a value the daemon refused, or a config file somebody has half-edited.
             Empty, and so invisible, when everything applied. -->
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,4,0,0">
            <Button Content="{loc:Tr Close}" Click="OnClose" />
            <Button Content="{loc:Tr Reset}" Click="OnReset" />
            <Button Content="{loc:Tr Help}">
                <Button.Flyout>
                    <Flyout>
                        <TextBlock MaxWidth="260" TextWrapping="Wrap"
                                   Text="{loc:Tr HelpText}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

    </StackPanel>

</Window>
