<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<!--
    The Secret Service, trimmed to the two members that say whether a keyring is usable: the
    default collection, and whether it is locked. Nothing here reads or writes a secret; that is
    wlrix-network's job, as NetworkManager's secret agent. Signatures from the Secret Service
    specification, unchanged.
-->

<node>
  <interface name="org.freedesktop.Secret.Service">
    <method name="ReadAlias">
      <arg type="s" name="name" direction="in"/>
      <arg type="o" name="collection" direction="out"/>
    </method>
  </interface>

  <interface name="org.freedesktop.Secret.Collection">
    <property type="b" name="Locked" access="read"/>
  </interface>
</node>
