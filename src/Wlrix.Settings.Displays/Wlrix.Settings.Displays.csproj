<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-settings-displays</AssemblyName>
        <Version>0.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- The banner picture; see tools/panel-banners.py. -->
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <!-- The arrangement math and the view models are `internal`; the tests are the only
             other thing with any business calling them. -->
        <InternalsVisibleTo Include="Wlrix.Settings.Displays.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The displays and the wlr-output-management feed. Monitors are configured live through
             the protocol, not through the settings daemon: see Wlrix.Settings.Outputs. -->
        <ProjectReference Include="../Wlrix.Settings.Outputs/Wlrix.Settings.Outputs.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The localized strings and the {loc:Tr} markup extension. -->
        <ProjectReference Include="../Wlrix.Common/Wlrix.Common.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Follows the session's color scheme, so this window is the same gray as the desktop
             behind it and stays that way when somebody changes it. One call in App.axaml.cs. -->
        <ProjectReference Include="../Wlrix.Theme/Wlrix.Theme.csproj" />
    </ItemGroup>

</Project>
