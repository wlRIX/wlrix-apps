<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.Settings.Audio.ViewModels"
        xmlns:models="using:Wlrix.Settings.Audio.Models"
        xmlns:loc="using:Wlrix.Common.Localization"
        x:Class="Wlrix.Settings.Audio.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="{loc:Tr PrefsTitle}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Grid.form > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.form > TextBlock.label">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="12" MinWidth="360">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="Bold" FontSize="16"
                   Margin="0,0,0,12" />

        <Button DockPanel.Dock="Bottom" Content="{loc:Tr PrefsClose}" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="80" Click="OnClose" />

        <Grid Classes="form" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnSpacing="8" RowSpacing="6">
            <TextBlock Grid.Row="0" Classes="label" Text="{loc:Tr PrefsDevice}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" MaxWidth="420"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
            <TextBlock Grid.Row="1" Classes="label" Text="{loc:Tr PrefsDriver}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Driver}" />
            <TextBlock Grid.Row="2" Classes="label" Text="{loc:Tr PrefsConnection}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Connection}" />
            <TextBlock Grid.Row="3" Classes="label" Text="{loc:Tr PrefsProfile}" IsVisible="{Binding HasCard}" />
            <ComboBox Grid.Row="3" Grid.Column="1" IsVisible="{Binding HasCard}"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:CardProfile">
                        <TextBlock Text="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{loc:Tr PrefsNoCard}"
                       TextWrapping="Wrap" MaxWidth="360" IsVisible="{Binding HasNoCard}" />
        </Grid>
    </DockPanel>
</Window>
