<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.Archiver.ViewModels"
        xmlns:loc="using:Wlrix.Common.Localization"
        xmlns:conv="using:Wlrix.Avalonia.Converters"
        xmlns:data="using:Avalonia.Data.Converters"
        xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Wlrix.Archiver.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="900" Height="600" MinWidth="560" MinHeight="320">
    <!-- The accelerators.
         A MenuItem's InputGesture only *draws* the shortcut, and its HotKey — which is meant
         to be the half that works — does not fire from inside a submenu that has never been
         opened. Both halves of that were established under the nested compositor with a
         virtual keyboard while fixing the file manager, which had the same arrangement and
         the same dead keys. Window.KeyBindings is what actually runs. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding New}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding Open}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding Extract}" />
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding Exit}" />
        <KeyBinding Gesture="Delete" Command="{Binding Remove}" />
    </Window.KeyBindings>


    <!--
        No SystemDecorations or ExtendClientArea: the compositor draws the 4Dwm frame, and a
        window that draws its own would get two.
    -->

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:IndentConverter x:Key="ArchiveIndent" Indent="16" />
        <FontFamily x:Key="ArchiveModeFont">DejaVu Sans Mono, Liberation Mono, Courier New, monospace</FontFamily>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <!-- A DockPanel rather than the default wrapping row, so Help sits on the right
                 edge the way every IRIX application put it. -->
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>

            <MenuItem Header="{loc:Tr MenuFile}" DockPanel.Dock="Left">
                <MenuItem Header="{loc:Tr FileNew}" InputGesture="Ctrl+N"
                          Command="{Binding New}" />
                <MenuItem Header="{loc:Tr FileOpen}" InputGesture="Ctrl+O"
                          Command="{Binding Open}" />
                <MenuItem Header="{loc:Tr FileExtract}" InputGesture="Ctrl+E"
                          Command="{Binding Extract}" />
                <Separator />
                <MenuItem Header="{loc:Tr FileExit}" InputGesture="Ctrl+Q"
                          Command="{Binding Exit}" />
            </MenuItem>

            <MenuItem Header="{loc:Tr MenuEdit}" DockPanel.Dock="Left">
                <MenuItem Header="{loc:Tr EditRemove}" InputGesture="Delete"
                          Command="{Binding Remove}" />
            </MenuItem>

            <!-- Not in the original specification, and here because it has to be somewhere: an
                 archive with no encoding recorded is guessed at, and a guess needs an override.
                 A radio group, because exactly one is in force at a time. -->
            <MenuItem Header="{loc:Tr MenuView}" DockPanel.Dock="Left">
                <MenuItem Header="{loc:Tr ViewEncoding}" ItemsSource="{Binding Encodings}">
                    <MenuItem.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem" x:DataType="vm:EncodingChoiceViewModel"
                                      BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="Command" Value="{Binding Choose}" />
                            <Setter Property="ToggleType" Value="Radio" />
                            <Setter Property="IsChecked" Value="{Binding IsChecked}" />
                        </ControlTheme>
                    </MenuItem.ItemContainerTheme>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="{loc:Tr MenuHelp}" DockPanel.Dock="Right">
                <MenuItem Header="{loc:Tr HelpAbout}" Command="{Binding ShowAbout}" />
            </MenuItem>
        </Menu>

        <!-- The status line. Says why the listing is empty when it is, what the last command
             did when it is not, and how far along the current one is while it runs.

             The gauge and the Cancel button only exist while something is running, and the
             gauge only when there is a real fraction to show — reading a 3 GB gzip takes the
             better part of a minute, and a window that looks dead for that long is the thing
             this is here to fix. -->
        <wlrix:BevelBorder DockPanel.Dock="Bottom" Bevel="Sunken" BevelThickness="1"
                           Background="{DynamicResource WlrixPanel}"
                           LightBrush="{DynamicResource WlrixPanelTopShadow}"
                           DarkBrush="{DynamicResource WlrixPanelBottomShadow}"
                           Padding="4,2" Margin="4,2,4,4">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="{loc:Tr Cancel}"
                        Command="{Binding Cancel}"
                        IsVisible="{Binding IsBusy}"
                        MinWidth="70" Margin="6,0,0,0" Padding="6,0" />
                <ProgressBar DockPanel.Dock="Right"
                             Minimum="0" Maximum="1"
                             Value="{Binding Progress}"
                             IsVisible="{Binding HasProgress}"
                             Width="160" Height="14" Margin="6,0,0,0"
                             VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </wlrix:BevelBorder>

        <!-- The column heading strip: a raised bar above the sunken well, as the IRIX file
             manager had it. Widths come from the shared ColumnLayout, two-way so a splitter
             drag writes back and every row follows. -->
        <wlrix:BevelBorder DockPanel.Dock="Top" Bevel="Raised" BevelThickness="2"
                           OuterLineThickness="1"
                           Background="{DynamicResource WlrixFace}"
                           LightBrush="{DynamicResource WlrixTopShadow}"
                           DarkBrush="{DynamicResource WlrixBottomShadow}"
                           OuterLineBrush="{DynamicResource WlrixOuterLine}"
                           Padding="2,1" Margin="4,4,4,0">
            <Grid Name="HeadingGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Columns.Name, Mode=TwoWay}" MinWidth="80" />
                    <ColumnDefinition Width="{Binding Columns.Splitter}" />
                    <ColumnDefinition Width="{Binding Columns.Size, Mode=TwoWay}" MinWidth="50" />
                    <ColumnDefinition Width="{Binding Columns.Splitter}" />
                    <ColumnDefinition Width="{Binding Columns.Mode, Mode=TwoWay}" MinWidth="50" />
                    <ColumnDefinition Width="{Binding Columns.Splitter}" />
                    <ColumnDefinition Width="{Binding Columns.Owner, Mode=TwoWay}" MinWidth="40" />
                    <ColumnDefinition Width="{Binding Columns.Splitter}" />
                    <ColumnDefinition Width="{Binding Columns.Group, Mode=TwoWay}" MinWidth="40" />
                    <ColumnDefinition Width="{Binding Columns.Splitter}" />
                    <ColumnDefinition Width="{Binding Columns.Date, Mode=TwoWay}" MinWidth="60" />
                    <ColumnDefinition Width="{Binding Columns.Gutter}" />
                </Grid.ColumnDefinitions>
                <Grid.Styles>
                    <!-- An etched rule the width of the gap, which is what an IRIX column
                         divider looked like and what the drag handle needs to be. -->
                    <Style Selector="GridSplitter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Background="Transparent" VerticalAlignment="Stretch">
                                    <wlrix:BevelBorder Bevel="Etched" BevelThickness="2" Width="2"
                                                       VerticalAlignment="Stretch" Margin="0,1"
                                                       LightBrush="{DynamicResource WlrixTopShadow}"
                                                       DarkBrush="{DynamicResource WlrixBottomShadow}" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="TextBlock">
                        <Setter Property="Margin" Value="4,0" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </Grid.Styles>

                <TextBlock Grid.Column="0" Text="{loc:Tr ColumnName}" />
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
                <TextBlock Grid.Column="2" Text="{loc:Tr ColumnSize}" HorizontalAlignment="Right" />
                <GridSplitter Grid.Column="3" ResizeDirection="Columns" />
                <TextBlock Grid.Column="4" Text="{loc:Tr ColumnMode}" />
                <GridSplitter Grid.Column="5" ResizeDirection="Columns" />
                <TextBlock Grid.Column="6" Text="{loc:Tr ColumnOwner}" />
                <GridSplitter Grid.Column="7" ResizeDirection="Columns" />
                <TextBlock Grid.Column="8" Text="{loc:Tr ColumnGroup}" />
                <GridSplitter Grid.Column="9" ResizeDirection="Columns" />
                <TextBlock Grid.Column="10" Text="{loc:Tr ColumnDate}" />
            </Grid>
        </wlrix:BevelBorder>

        <!-- The listing. A Panel so the empty-state message can sit over the well rather than
             inside it as a fake row. -->
        <Panel Margin="4,0,4,0">
            <TreeView Name="EntryTree"
                      ItemsSource="{Binding Roots}"
                      SelectionMode="Multiple"
                      IsEnabled="{Binding !IsBusy}"
                      DragDrop.AllowDrop="True"
                      ItemContainerTheme="{StaticResource ArchiveTreeItem}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="vm:EntryNodeViewModel" ItemsSource="{Binding Children}">
                        <Grid Background="Transparent">
                            <!-- The same columns as the heading, one-way. The two agree because
                                 they read the same ColumnLayout, not because the widths are
                                 written down twice. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Columns.Name}" />
                                <ColumnDefinition Width="{Binding Columns.Splitter}" />
                                <ColumnDefinition Width="{Binding Columns.Size}" />
                                <ColumnDefinition Width="{Binding Columns.Splitter}" />
                                <ColumnDefinition Width="{Binding Columns.Mode}" />
                                <ColumnDefinition Width="{Binding Columns.Splitter}" />
                                <ColumnDefinition Width="{Binding Columns.Owner}" />
                                <ColumnDefinition Width="{Binding Columns.Splitter}" />
                                <ColumnDefinition Width="{Binding Columns.Group}" />
                                <ColumnDefinition Width="{Binding Columns.Splitter}" />
                                <ColumnDefinition Width="{Binding Columns.Date}" />
                                <ColumnDefinition Width="{Binding Columns.Gutter}" />
                            </Grid.ColumnDefinitions>

                            <!-- Only this cell indents. Everything to the right of it stays put,
                                 which is what keeps a nested row lined up with the heading. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                        Margin="{Binding Depth, Converter={StaticResource ArchiveIndent}}">
                                <ToggleButton Theme="{StaticResource ArchiveTreeExpandToggle}"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding HasChildren}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                                <!-- Holds the toggle's width on a leaf so names still align. -->
                                <Panel Width="11" IsVisible="{Binding !HasChildren}" />
                                <Path Width="16" Height="16" Stretch="None"
                                      VerticalAlignment="Center"
                                      Data="M1,4 L1,3 L6,3 L7,4.5 L15,4.5 L15,13 L1,13 Z"
                                      Fill="{DynamicResource WlrixFace}"
                                      Stroke="{DynamicResource WlrixOuterLine}"
                                      StrokeThickness="1"
                                      IsVisible="{Binding IsDirectory}" />
                                <Path Width="16" Height="16" Stretch="None"
                                      VerticalAlignment="Center"
                                      Data="M3,1 L10,1 L13,4 L13,15 L3,15 Z M10,1 L10,4 L13,4"
                                      Fill="{DynamicResource WlrixTopShadow}"
                                      Stroke="{DynamicResource WlrixOuterLine}"
                                      StrokeThickness="1"
                                      IsVisible="{Binding !IsDirectory}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                       HorizontalAlignment="Right" Margin="4,0" />
                            <!-- Fixed width so the permission bits line up down the column, and
                                 a real fallback chain rather than the bare generic name: a
                                 family Avalonia cannot resolve throws out of the layout pass
                                 instead of falling back, taking the window with it. -->
                            <TextBlock Grid.Column="4" Text="{Binding ModeText}" Margin="4,0"
                                       FontFamily="{StaticResource ArchiveModeFont}" />
                            <TextBlock Grid.Column="6" Text="{Binding OwnerText}" Margin="4,0" />
                            <TextBlock Grid.Column="8" Text="{Binding GroupText}" Margin="4,0" />
                            <TextBlock Grid.Column="10" Text="{Binding DateText}" Margin="4,0"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Why the listing is empty, in the middle of the well where the rows would be.
                 Hidden while something is running: the status line below is already saying the
                 same sentence, and printing it twice reads as a stutter rather than emphasis. -->
            <TextBlock Text="{Binding Status}"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource WlrixViewForeground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static data:BoolConverters.And}">
                        <Binding Path="IsEmpty" />
                        <Binding Path="!IsBusy" />
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>
        </Panel>
    </DockPanel>
</Window>
