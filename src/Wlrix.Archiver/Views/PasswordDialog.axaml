<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Wlrix.Common.Localization"
        x:Class="Wlrix.Archiver.Views.PasswordDialog"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Name="Prompt" TextWrapping="Wrap" />
        <TextBox Name="Input" PasswordChar="*" />
        <!-- Only shown when creating, where there is still a choice to make about it. An
             archive being opened already is or is not one with encrypted names. -->
        <StackPanel Name="NameOption" Spacing="4" IsVisible="False">
            <CheckBox Name="EncryptNames" Content="{loc:Tr NewEncryptNames}" />
            <TextBlock Name="NameOptionHint" Text="{loc:Tr NewEncryptNamesHint}"
                       TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="Accept" Content="{loc:Tr DialogOk}" MinWidth="80" IsDefault="True" />
            <Button Name="Reject" Content="{loc:Tr DialogCancel}" MinWidth="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
