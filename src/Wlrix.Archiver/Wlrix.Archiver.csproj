<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-archiver</AssemblyName>
        <Version>0.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- Not compiled or copied: the desktop entry is installed by the Justfile, not by the
             build. Listed so it is visible in the IDE rather than an orphan directory. -->
        <None Include="data\**" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wlrix.Archiver.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia.Dialogs" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="ZLogger" />
    </ItemGroup>

    <ItemGroup>
        <!-- The archive engine. Pure managed with a real net10.0 target, MIT, and — the reason
             it beats shelling out to tar(1) for everything — an `ArchiveEncoding.CustomDecoder`
             hook, which is where the legacy-codepage filename handling plugs in. -->
        <PackageReference Include="SharpCompress" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wlrix.Common\Wlrix.Common.csproj" />
    </ItemGroup>
</Project>
