<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.SoftwareManager.ViewModels"
        xmlns:user="using:Wlrix.Packages.UserSoftware"
        xmlns:loc="using:Wlrix.Common.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="420"
        Width="600" Height="420" MinWidth="440" MinHeight="300"
        x:Class="Wlrix.SoftwareManager.Views.Dialogs.UserSoftwareDialog"
        x:DataType="vm:UserSoftwareViewModel"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr UserSoftwareTitle}">

    <Design.DataContext>
        <vm:UserSoftwareViewModel />
    </Design.DataContext>

    <DockPanel Margin="12">

        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr UserSoftwareExplanation}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />

        <!-- Adding one. The field takes a typed path or a dropped file; there is no file
             chooser because wlRIX ships no FileChooser portal for one to go through. -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
              Margin="0,10,0,0"
              DragDrop.AllowDrop="True"
              DragDrop.DragOver="OnDragOver"
              DragDrop.Drop="OnDrop">
            <TextBlock Grid.Column="0" Text="{loc:Tr UserSoftwareFile}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Path}"
                     PlaceholderText="{loc:Tr UserSoftwareFileHint}" />
            <Button Grid.Column="2" Content="{loc:Tr UserSoftwareInstall}" MinWidth="80"
                    Command="{Binding Install}" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="{loc:Tr UserSoftwareRemove}" MinWidth="80" Command="{Binding Remove}" />
            <Button Content="{loc:Tr Close}" MinWidth="80" Click="OnClose" IsCancel="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding Selected}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="user:UserPackage">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeKilobytes}"
                                   TextAlignment="Right" MinWidth="80" />
                        <TextBlock Grid.Column="2" Text="{Binding Installed, StringFormat={}{0:d}}"
                                   MinWidth="90" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</Window>
