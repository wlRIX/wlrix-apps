<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.SoftwareManager.ViewModels"
        xmlns:loc="using:Wlrix.Common.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="420"
        Width="620" Height="420" MinWidth="460" MinHeight="320"
        x:Class="Wlrix.SoftwareManager.Views.Dialogs.RepositoriesDialog"
        x:DataType="vm:RepositoriesViewModel"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr RepositoriesTitle}">

    <Design.DataContext>
        <vm:RepositoriesViewModel />
    </Design.DataContext>

    <DockPanel Margin="12">

        <!-- Adding one. Hidden entirely where the package manager has no command for it,
             rather than shown disabled: there is nothing the user could do to enable it. -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0"
                    IsVisible="{Binding CanModify}">
            <Grid ColumnDefinitions="Auto,*,Auto,2*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{loc:Tr RepositoryAlias}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding NewAlias}" />
                <TextBlock Grid.Column="2" Text="{loc:Tr RepositoryUrl}" VerticalAlignment="Center" />
                <TextBox Grid.Column="3" Text="{Binding NewUrl}" />
                <Button Grid.Column="4" Content="{loc:Tr RepositoryAdd}" MinWidth="70"
                        Command="{Binding Add}" />
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="{loc:Tr RepositoryEnable}" MinWidth="80" Command="{Binding Enable}"
                    IsVisible="{Binding CanModify}" />
            <Button Content="{loc:Tr RepositoryDisable}" MinWidth="80" Command="{Binding Disable}"
                    IsVisible="{Binding CanModify}" />
            <Button Content="{loc:Tr RepositoryRemove}" MinWidth="80" Command="{Binding Remove}"
                    IsVisible="{Binding CanModify}" />
            <Button Content="{loc:Tr Close}" MinWidth="80" Click="OnClose"
                    IsCancel="True" HorizontalAlignment="Right" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <ListBox ItemsSource="{Binding Repositories}" SelectedItem="{Binding Selected}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RepositoryRowViewModel">
                    <Grid ColumnDefinitions="2*,3*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Url}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding StateText}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>

</Window>
