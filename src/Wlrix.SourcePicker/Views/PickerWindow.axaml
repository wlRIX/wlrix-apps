<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.SourcePicker.ViewModels"
        xmlns:controls="using:Wlrix.SourcePicker.Controls"
        xmlns:loc="using:Wlrix.Common.Localization"
        xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="620"
        Width="620" Height="620" MinWidth="420" MinHeight="360"
        x:Class="Wlrix.SourcePicker.Views.PickerWindow"
        x:DataType="vm:PickerViewModel"
        WindowStartupLocation="CenterScreen"
        Title="{loc:Tr WindowTitle}">

    <Window.Resources>
        <!-- One tile. Shared by both grids so a monitor and a window are the same object with
             different contents, which is what they are. -->
        <DataTemplate x:Key="SourceTile" x:DataType="vm:SourceViewModel">
            <controls:LedButton Margin="4"
                                Title="{Binding Title}"
                                Subtitle="{Binding Subtitle}"
                                Preview="{Binding Preview}"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- What is being asked, and by whom -->
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="2,0,2,10">
            <TextBlock Text="{Binding Prompt}" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource WlrixDisabledForeground}" />
            <TextBlock Text="{loc:Tr CursorVisible}"
                       Foreground="{DynamicResource WlrixDisabledForeground}"
                       IsVisible="{Binding ShowsCursor}" />
        </StackPanel>

        <!-- Buttons. Docked before the scroller so they keep their height when the list is
             long, rather than being pushed off the bottom. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="{loc:Tr Cancel}" MinWidth="90" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr Share}" MinWidth="90" Click="OnShare" IsDefault="True"
                    Command="{Binding Share}" />
        </StackPanel>

        <wlrix:BevelBorder Bevel="Sunken" BevelThickness="2" OuterLineThickness="1"
                           Background="{DynamicResource WlrixViewBackground}"
                           LightBrush="{DynamicResource WlrixTopShadow}"
                           DarkBrush="{DynamicResource WlrixBottomShadow}"
                           OuterLineBrush="{DynamicResource WlrixOuterLine}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="4">
                <StackPanel>
                    <!-- Monitors first: sharing a screen is the common answer, and it is the
                         one that is always available. -->
                    <TextBlock Text="{loc:Tr Screens}" Margin="6,4" FontWeight="Bold"
                               IsVisible="{Binding HasMonitors}" />
                    <ItemsControl ItemsSource="{Binding Monitors}"
                                  ItemTemplate="{StaticResource SourceTile}"
                                  IsVisible="{Binding HasMonitors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- The separator between the two groups, as the KDE picker has. Hidden
                         when there is nothing under it, so a request for screens only does not
                         end in a heading over empty space. -->
                    <Border Height="1" Margin="6,12,6,2"
                            Background="{DynamicResource WlrixBottomShadow}"
                            IsVisible="{Binding HasWindows}" />
                    <TextBlock Text="{loc:Tr Windows}" Margin="6,4" FontWeight="Bold"
                               IsVisible="{Binding HasWindows}" />
                    <ItemsControl ItemsSource="{Binding Windows}"
                                  ItemTemplate="{StaticResource SourceTile}"
                                  IsVisible="{Binding HasWindows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Only when the compositor really had nothing to offer. -->
                    <TextBlock Text="{loc:Tr NothingToShare}"
                               Margin="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource WlrixDisabledForeground}">
                        <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!HasMonitors" />
                                <Binding Path="!HasWindows" />
                            </MultiBinding>
                        </TextBlock.IsVisible>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </wlrix:BevelBorder>
    </DockPanel>

</Window>
