<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
             x:Class="Wlrix.SourcePicker.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <wlrix:WlrixTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The source tile, built from the theme's own primitives. -->
                <ResourceInclude Source="avares://wlrix-source-picker/Themes/LedButton.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
