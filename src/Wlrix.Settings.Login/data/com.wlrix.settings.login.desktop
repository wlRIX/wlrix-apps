[Desktop Entry]
Type=Application
Name=Login Settings
Comment=Set the login screen's keyboard layout, color scheme and displays
Icon=preferences-system-login
Categories=Settings;System;
Keywords=login;greeter;display manager;keyboard;layout;scheme;monitor;
Exec=wlrix-settings-login
TryExec=wlrix-settings-login
Terminal=false

# One of wlRIX's control panels: the icon catalog files it on its ControlPanels page and stands
# it on the control panel carpet. A wlRIX extension; the X- prefix keeps the file valid elsewhere.
X-WLRIX-ControlPanel=true

# Matches the Wayland app id set in Program.BuildAvaloniaApp. `wlrix-desktop` looks a running
# window up by StartupWMClass first, and wlrix-compositor frames the window by the same id.
StartupWMClass=com.wlrix.settings.login
StartupNotify=false
