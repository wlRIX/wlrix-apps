<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-settings-login</AssemblyName>
        <Version>0.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia.Dialogs" />
    </ItemGroup>

    <ItemGroup>
        <!-- The view models are `internal`; the tests are the only other thing that calls them. -->
        <InternalsVisibleTo Include="Wlrix.Settings.Login.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The localized strings and the {loc:Tr} markup extension. -->
        <ProjectReference Include="../Wlrix.Common/Wlrix.Common.csproj" />
        <!-- The login screen's settings, their validation, and the pkexec runner for the helper
             that writes them. The helper itself is Wlrix.Settings.Login.Helper. -->
        <ProjectReference Include="../Wlrix.Settings.Login.Core/Wlrix.Settings.Login.Core.csproj" />
        <!-- The connected displays, offered as the choices for the login screen's. -->
        <ProjectReference Include="../Wlrix.Settings.Outputs/Wlrix.Settings.Outputs.csproj" />
        <!-- The current user's keyboard and scheme, for the Copy menu. Read only: this panel
             never writes a user setting. -->
        <ProjectReference Include="../Wlrix.Settings.Client/Wlrix.Settings.Client.csproj" />
        <!-- Follows the session's color scheme. One call in App.axaml.cs. -->
        <ProjectReference Include="../Wlrix.Theme/Wlrix.Theme.csproj" />
    </ItemGroup>

</Project>
