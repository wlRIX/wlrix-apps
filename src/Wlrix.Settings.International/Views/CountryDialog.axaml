<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:Wlrix.Settings.International.Services"
        xmlns:loc="using:Wlrix.Common.Localization"
        x:Class="Wlrix.Settings.International.Views.CountryDialog"
        Width="520" Height="560" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr CountryTitle}">

    <!-- IRIX's Country dialog: a heading, what choosing does, the list, and OK / Cancel. A filter
         field is added, because the list is the whole world rather than SGI's sales regions. -->
    <DockPanel Margin="14" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr CountryHeading}" FontWeight="Bold" FontSize="14"
                   Margin="0,0,0,10" />
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr CountryExplanation}" TextWrapping="Wrap"
                   Margin="0,0,0,10" />
        <TextBox DockPanel.Dock="Top" x:Name="Filter" PlaceholderText="{loc:Tr FilterHint}" Margin="0,0,0,6" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,12,0,0">
            <Button Content="{loc:Tr Ok}" MinWidth="80" Click="OnOk" IsDefault="True" />
            <Button Content="{loc:Tr Cancel}" MinWidth="80" Click="OnCancel" IsCancel="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{loc:Tr OkCancelHint}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <ListBox x:Name="List" DoubleTapped="OnDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="svc:Country">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
