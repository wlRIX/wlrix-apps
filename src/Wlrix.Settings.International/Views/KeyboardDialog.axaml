<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Wlrix.Settings.International.Views"
        xmlns:svc="using:Wlrix.Settings.International.Services"
        xmlns:loc="using:Wlrix.Common.Localization"
        x:Class="Wlrix.Settings.International.Views.KeyboardDialog"
        Width="820" Height="620" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr KeyboardTitle}">

    <!-- IRIX's Keyboard Selection, grown to the list of layouts xkb can switch between: the
         layouts in use on the left, in order, with the selected one's variant under them; the
         layouts to add from on the right, narrowed to the country by the Show menu. The model and
         the switch key apply to the keyboard as a whole. -->
    <DockPanel Margin="14" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr KeyboardHeading}" FontWeight="Bold" FontSize="14"
                   Margin="0,0,0,10" />
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr KeyboardExplanation}" TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,12,0,0">
            <Button Content="{loc:Tr Ok}" MinWidth="80" Click="OnOk" IsDefault="True" />
            <Button Content="{loc:Tr Cancel}" MinWidth="80" Click="OnCancel" IsCancel="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{loc:Tr OkCancelHint}" TextWrapping="Wrap" Margin="0,10,0,0" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,8,Auto" Margin="0,10,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Model}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="2" x:Name="Model" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:XkbItem">
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr SwitchKey}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="SwitchKey" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:XkbItem">
                        <TextBlock Text="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid ColumnDefinitions="*,10,Auto,10,*" RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr LayoutsInUse}" FontWeight="Bold" Margin="0,0,0,4" />
            <ListBox Grid.Row="1" Grid.Column="0" x:Name="InUse" SelectionChanged="OnInUseSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="views:LayoutRow">
                        <TextBlock Text="{Binding Text}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="Auto,8,*" Margin="0,6,0,0">
                <TextBlock Grid.Column="0" Text="{loc:Tr Variant}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" x:Name="Variant" HorizontalAlignment="Stretch"
                          SelectionChanged="OnVariant">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:XkbVariant">
                            <TextBlock Text="{Binding Description}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                <Button Content="{loc:Tr AddLayout}" HorizontalAlignment="Stretch" Click="OnAdd" />
                <Button Content="{loc:Tr RemoveLayout}" HorizontalAlignment="Stretch" Click="OnRemove" />
                <Button Content="{loc:Tr MoveUp}" HorizontalAlignment="Stretch" Click="OnUp" />
                <Button Content="{loc:Tr MoveDown}" HorizontalAlignment="Stretch" Click="OnDown" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                <TextBlock Text="{loc:Tr Show}" VerticalAlignment="Center" FontWeight="Bold" />
                <ComboBox x:Name="Scope" MinWidth="200" SelectionChanged="OnScope" />
            </StackPanel>
            <ListBox Grid.Row="1" Grid.Column="4" Grid.RowSpan="2" x:Name="Available" DoubleTapped="OnAvailableDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:XkbLayout">
                        <TextBlock Text="{Binding Description}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
