<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Wlrix.Settings.International.Views"
        xmlns:loc="using:Wlrix.Common.Localization"
        x:Class="Wlrix.Settings.International.Views.LanguageDialog"
        Width="760" Height="600" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr LanguageTitle}">

    <!-- The language, which is LANG and so the words programs use, and beside it the formats:
         dates, numbers, money, paper and units, which default to the language's own. A preview
         of the formats underneath, since "de_DE" says less than "Samstag, 24. Oktober 2026". -->
    <DockPanel Margin="14" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr LanguageHeading}" FontWeight="Bold" FontSize="14"
                   Margin="0,0,0,10" />
        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr LanguageExplanation}" TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,12,0,0">
            <Button Content="{loc:Tr Ok}" MinWidth="80" Click="OnOk" IsDefault="True" />
            <Button Content="{loc:Tr Cancel}" MinWidth="80" Click="OnCancel" IsCancel="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{loc:Tr OkCancelHint}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <TextBlock DockPanel.Dock="Bottom" x:Name="GenerateNote" Text="{loc:Tr GenerateNote}"
                   TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="False" />

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,12,*" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="{loc:Tr FormatsPreview}" FontWeight="Bold" />
            <TextBlock Grid.Column="2" x:Name="Preview" TextWrapping="Wrap" />
        </Grid>

        <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,Auto,*">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr LanguageList}" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Tr FormatsList}" FontWeight="Bold" Margin="0,0,0,4" />
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8"
                        Margin="0,0,0,6">
                <TextBlock Text="{loc:Tr Show}" VerticalAlignment="Center" />
                <ComboBox x:Name="Scope" MinWidth="220" SelectionChanged="OnScope" />
            </StackPanel>
            <ListBox Grid.Row="2" Grid.Column="0" x:Name="Languages" SelectionChanged="OnSelection">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="views:LocaleRow">
                        <TextBlock Text="{Binding Text}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ListBox Grid.Row="2" Grid.Column="2" x:Name="Formats" SelectionChanged="OnSelection">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="views:LocaleRow">
                        <TextBlock Text="{Binding Text}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
