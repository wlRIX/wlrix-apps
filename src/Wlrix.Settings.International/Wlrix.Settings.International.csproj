<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-settings-international</AssemblyName>
        <Version>0.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- The .desktop entry and the icon, installed by the Justfile's install-desktop rather
             than built. Listed so they are visible in the IDE rather than an orphan directory. -->
        <None Include="data\**" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wlrix.Settings.International.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- systemd-localed and systemd-timedated, which own the system language, keyboard, time
             zone and clock; the XML headers say where they came from. -->
        <AdditionalFiles Include="DBusXml/org.freedesktop.locale1.xml"
                         Namespace="Wlrix.Settings.International.DBus"
                         DBusGeneratorMode="Proxy" />
        <AdditionalFiles Include="DBusXml/org.freedesktop.timedate1.xml"
                         Namespace="Wlrix.Settings.International.DBus"
                         DBusGeneratorMode="Proxy" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia" />
        <PackageReference Include="Tmds.DBus.Protocol" />
        <PackageReference Include="Tmds.DBus.Generator" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- The localized strings and the {loc:Tr} markup extension. -->
        <ProjectReference Include="../Wlrix.Common/Wlrix.Common.csproj" />
        <!-- What a locale name may be, and the runner for the helper that generates one. -->
        <ProjectReference Include="../Wlrix.Settings.International.Core/Wlrix.Settings.International.Core.csproj" />
        <!-- The personal keyboard: `compositor.keyboard.*`. -->
        <ProjectReference Include="../Wlrix.Settings.Client/Wlrix.Settings.Client.csproj" />
        <!-- Follows the session's color scheme. One call in App.axaml.cs. -->
        <ProjectReference Include="../Wlrix.Theme/Wlrix.Theme.csproj" />
        <!-- The four big buttons' pictures, which are other panels' icons. -->
        <ProjectReference Include="../Wlrix.Icons/Wlrix.Icons.csproj" />
    </ItemGroup>

</Project>
