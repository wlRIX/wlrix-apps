<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-desks</AssemblyName>
        <Version>0.0.0</Version>
        <!-- NWayland's generated bindings and runtime interop are unsafe. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <!-- The wlrix-desks C# bindings are generated at build time by NWayland's source generator
         (wired below as an analyzer) from the protocol XML kept alongside the other Wayland
         protocol sets in the wlRIX NWayland fork. That copy must stay in step with the
         compositor's `wlrix-compositor/src/protocols/wlrix-desks.xml`, which is what the
         compositor itself compiles. The generated code carries incomplete XML doc comments, so
         those doc warnings are kept warnings rather than errors here. -->
    <ItemGroup>
        <AdditionalFiles Include="../../../NWayland/external/wlrix-protocols/wlrix-desks.xml"
                         NWaylandNamespace="NWayland.Protocols" />
    </ItemGroup>
    <PropertyGroup>
        <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591;CS1573;CS1572;CS1570;CS1571;CS1574;CS1580;CS1581;CS1584</WarningsNotAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia.Dialogs" />
        <!-- NWayland runtime (WlDisplay/WlRegistry + core protocols), pinned in
             Directory.Packages.props to the version Avalonia.Wayland binds to. -->
        <PackageReference Include="NWayland" />
        <!-- The options in CommandLine/, which follow the IRIX `ov` man page. -->
        <PackageReference Include="CommandLineParser" />
        <!-- The session-bus half of the single-instance guard. Avalonia.FreeDesktop already
             drags this assembly into the output through Avalonia.Wayland, so referencing it
             adds nothing to what ships — the reference only stops NuGet resolving a second,
             differently-versioned copy. Its readers and writers are `unsafe`, which this
             project already allows for NWayland. -->
        <PackageReference Include="Tmds.DBus.Protocol" />
    </ItemGroup>

    <ItemGroup>
        <!-- The argument parsing and the settings store are `internal`: they are this
             application's own plumbing, not API, and the test project is the only other
             thing that has any business calling them. -->
        <InternalsVisibleTo Include="Wlrix.Desks.Tests" />
    </ItemGroup>

    <!-- Wires the wlRIX NWayland fork's source generator as an analyzer (the fork carries codegen
         fixes the published package does not) and, crucially, makes the NWaylandNamespace
         metadata on AdditionalFiles compiler-visible so the generator picks up wlrix-desks.xml.
         The targets reference the generator with ReferenceOutputAssembly="false", so the fork
         supplies codegen only: the NWayland assembly the app loads is the nuget one above. -->
    <Import Project="../../../NWayland/src/NWayland.Generator/NWayland.Generator.Use.targets" />
    <ItemGroup>
        <!-- Follows the session's color scheme, so this window is the same gray as the desktop
             behind it and stays that way when somebody changes it. One call in App.axaml.cs. -->
        <ProjectReference Include="../Wlrix.Theme/Wlrix.Theme.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The localized strings and the {loc:Tr} markup extension. -->
        <ProjectReference Include="../Wlrix.Common/Wlrix.Common.csproj" />
    </ItemGroup>

</Project>
