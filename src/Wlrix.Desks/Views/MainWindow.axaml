<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.Desks.ViewModels"
        xmlns:controls="using:Wlrix.Desks.Controls"
        xmlns:views="using:Wlrix.Desks.Views"
        xmlns:loc="using:Wlrix.Common.Localization"
        xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="250"
        Width="720" Height="230"
        x:Name="Root"
        x:Class="Wlrix.Desks.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr WindowTitle}">
    <!-- The accelerators.
         A MenuItem's InputGesture only *draws* the shortcut, and its HotKey — which is meant
         to be the half that works — does not fire from inside a submenu that has never been
         opened. Both were established under the nested compositor with a virtual keyboard
         while fixing wlRIX Files, which had the same arrangement and the same dead keys.
         Window.KeyBindings is what runs, and it needs commands, which is why the items with
         shortcuts stopped being Click handlers. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Q" Command="{Binding Exit}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDesk}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding RenameSelected}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding GotoSelected}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding MinimizeAll}" />
        <KeyBinding Gesture="Shift+Ctrl+M" Command="{Binding RestoreAll}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding AddSelectedToGlobal}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding RemoveSelectedFromDesk}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding MinimizeSelected}" />
        <KeyBinding Gesture="Shift+Ctrl+E" Command="{Binding RestoreSelected}" />
    </Window.KeyBindings>



    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <!-- The desk list's items are only a place for a tile to sit: the tile draws its own
             selection, so the theme's highlight behind the item is turned off, and with it the
             padding and the selected-text color meant to sit on that highlight. -->
        <Style Selector="ListBox#DeskList ListBoxItem">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox#DeskList ListBoxItem:selected /template/ Border#Root">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock.name">
            <Setter Property="Foreground" Value="{DynamicResource WlrixForeground}" />
        </Style>

        <!-- A tile shows its state in the two pixels inside its outline, as IRIX's overview did
             and with the colors its icons used: face at rest, white under the pointer, lamp
             yellow selected. Measured off an IRIX screen, a drop target turns the same ring
             royal blue (WlrixIconTintDrop), for when windows can be dragged between desks.
             Selection comes second so it wins under the pointer. -->
        <Style Selector="Border.ring">
            <Setter Property="BorderBrush" Value="{DynamicResource WlrixFace}" />
        </Style>
        <Style Selector="Border.tile:pointerover > Border.ring">
            <Setter Property="BorderBrush" Value="{DynamicResource WlrixIconTintHover}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.ring">
            <Setter Property="BorderBrush" Value="{DynamicResource WlrixIconTintSelected}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- A desk tile: a flat face with the desk's lamp (lit when it is the active desk) and
             name, over a picture of where its windows are. IRIX drew these as surfaces rather
             than buttons, which is why there is no bevel here. Shared by the pinned Global tile
             and the scrollable desk list. -->
        <DataTemplate x:Key="DeskTile" x:DataType="vm:DeskViewModel">
            <Border Classes="tile" Margin="2" BorderThickness="1"
                    BorderBrush="{DynamicResource WlrixOuterLine}"
                    Background="{DynamicResource WlrixFace}">
                <Border Classes="ring" BorderThickness="2">
                    <StackPanel>
                        <!-- Header: lamp + desk name -->
                        <DockPanel Margin="4,3">
                            <wlrix:BevelBorder Bevel="Sunken" BevelThickness="1"
                                             OuterLineThickness="1" Width="14" Height="14"
                                             Margin="0,0,8,0" VerticalAlignment="Center"
                                             Background="{DynamicResource WlrixFace}"
                                             LightBrush="{DynamicResource WlrixTopShadow}"
                                             DarkBrush="{DynamicResource WlrixBottomShadow}"
                                             OuterLineBrush="{DynamicResource WlrixOuterLine}">
                                <!-- Lit when active; hidden otherwise so the unlit face shows. -->
                                <Border Margin="1"
                                        Background="{DynamicResource WlrixIndicatorLight}"
                                        IsVisible="{Binding IsActive}" />
                            </wlrix:BevelBorder>
                            <!-- The name is renamed in place (IRIX had no rename prompt): the label
                                 gives way to a text field for the length of the edit. -->
                            <Panel MinHeight="20">
                                <TextBlock Classes="name" Text="{Binding Name}" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !IsEditing}" />
                                <TextBox Name="NameEditor" Text="{Binding EditName}"
                                         FontWeight="Bold" Padding="2,0" VerticalAlignment="Center"
                                         IsVisible="{Binding IsEditing}"
                                         KeyDown="OnRenameKeyDown"
                                         LostFocus="OnRenameLostFocus" />
                            </Panel>
                        </DockPanel>

                        <!-- Window geometry preview, running out to the ring on three sides.
                             The box carries the screen layout's aspect ratio, so the tile is the
                             shape of the screen rather than letterboxing inside a fixed box. -->
                        <Border Background="{DynamicResource WlrixViewBackground}"
                                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowSnapshots}">
                            <controls:DeskPreview Width="{Binding PreviewWidth}"
                                                  Height="{Binding PreviewHeight}"
                                                  Windows="{Binding PreviewWindows}"
                                                  WindowBrush="{DynamicResource WlrixFace}"
                                                  WindowBorderBrush="{DynamicResource WlrixForeground}"
                                                  HoverBorderBrush="White"
                                                  SelectionBorderBrush="{DynamicResource WlrixSelectFill}"
                                                  HoveredWindowId="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HoveredWindowId, Mode=TwoWay}"
                                                  SelectedWindowId="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedWindowId, Mode=TwoWay}"
                                                  LabelMode="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WindowLabel}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Menu bar -->
        <wlrix:MenuBar DockPanel.Dock="Top">
            <MenuItem Header="{loc:Tr MenuOverview}">
                <MenuItem Header="{Binding GlobalDeskMenuHeader}" Click="OnToggleGlobalDesk" />
                <MenuItem Header="{Binding SnapshotsMenuHeader}" Click="OnToggleSnapshots" />
                <Separator />
                <!-- What the miniature windows say under the pointer. `ov` had one switch
                     here, noWindowName, and no way to change it once the program was up; the
                     third state and the menu are so a flag somebody passed once is not a thing
                     they have to relaunch to undo. The check marks are one-way: the handlers
                     own the change, and a radio group writing back would fight them. -->
                <MenuItem Header="{loc:Tr ShowWindowNames}" ToggleType="Radio" GroupName="WindowLabel"
                          IsChecked="{Binding ShowsWindowNames, Mode=OneWay}" Click="OnShowWindowNames" />
                <MenuItem Header="{loc:Tr ShowApplicationIds}" ToggleType="Radio" GroupName="WindowLabel"
                          IsChecked="{Binding ShowsApplicationIds, Mode=OneWay}" Click="OnShowApplicationIds" />
                <MenuItem Header="{loc:Tr ShowNoNames}" ToggleType="Radio" GroupName="WindowLabel"
                          IsChecked="{Binding ShowsNoNames, Mode=OneWay}" Click="OnShowNoNames" />
                <Separator />
                <MenuItem Header="{loc:Tr Exit}" InputGesture="Ctrl+Q" Command="{Binding Exit}" />
            </MenuItem>
            <MenuItem Header="{loc:Tr MenuDesk}">
                <MenuItem Header="{loc:Tr NewDesk}" InputGesture="Ctrl+N" Command="{Binding NewDesk}" />
                <MenuItem Header="{loc:Tr RenameSelected}" InputGesture="Ctrl+R"
                          Command="{Binding RenameSelected}" IsEnabled="{Binding CanOperateOnSelected}" />
                <MenuItem Header="{loc:Tr GotoSelected}" InputGesture="Ctrl+O" Command="{Binding GotoSelected}"
                          IsEnabled="{Binding CanOperateOnSelected}" />
                <MenuItem Header="{loc:Tr DeleteSelected}" Command="{Binding DeleteSelected}"
                          IsEnabled="{Binding CanOperateOnSelected}" />
                <Separator />
                <!-- How large the snapshots are drawn. The radio items are one-way for the same
                     reason as the Overview menu's: the handlers own the change. The user-defined
                     amount is listed once the Custom dialog has set one. -->
                <MenuItem Header="{loc:Tr Scaling}">
                    <MenuItem Header="{loc:Tr Scale6}" ToggleType="Radio" GroupName="Scale" Tag="6"
                              IsChecked="{Binding CheckedPresetScale, Mode=OneWay, Converter={x:Static views:ScaleConverters.IsPreset}, ConverterParameter=6}"
                              Click="OnPresetScale" />
                    <MenuItem Header="{loc:Tr Scale7}" ToggleType="Radio" GroupName="Scale" Tag="7"
                              IsChecked="{Binding CheckedPresetScale, Mode=OneWay, Converter={x:Static views:ScaleConverters.IsPreset}, ConverterParameter=7}"
                              Click="OnPresetScale" />
                    <MenuItem Header="{loc:Tr Scale8}" ToggleType="Radio" GroupName="Scale" Tag="8"
                              IsChecked="{Binding CheckedPresetScale, Mode=OneWay, Converter={x:Static views:ScaleConverters.IsPreset}, ConverterParameter=8}"
                              Click="OnPresetScale" />
                    <MenuItem Header="{loc:Tr Scale9}" ToggleType="Radio" GroupName="Scale" Tag="9"
                              IsChecked="{Binding CheckedPresetScale, Mode=OneWay, Converter={x:Static views:ScaleConverters.IsPreset}, ConverterParameter=9}"
                              Click="OnPresetScale" />
                    <MenuItem Header="{loc:Tr Scale10}" ToggleType="Radio" GroupName="Scale" Tag="10"
                              IsChecked="{Binding CheckedPresetScale, Mode=OneWay, Converter={x:Static views:ScaleConverters.IsPreset}, ConverterParameter=10}"
                              Click="OnPresetScale" />
                    <MenuItem Header="{Binding UserDefinedScaleMenuHeader}" ToggleType="Radio" GroupName="Scale"
                              IsVisible="{Binding HasUserDefinedScale}"
                              IsChecked="{Binding UseUserDefinedScale, Mode=OneWay}"
                              Click="OnUserDefinedScale" />
                    <MenuItem Header="{loc:Tr CustomScale}" Click="OnCustomScale" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{loc:Tr MenuWindow}">
                <MenuItem Header="{loc:Tr ListAll}" InputGesture="Ctrl+L" IsEnabled="False" />
                <MenuItem Header="{loc:Tr MinimizeAll}" InputGesture="Ctrl+M"
                          Command="{Binding MinimizeAll}" />
                <MenuItem Header="{loc:Tr RestoreAll}" InputGesture="Shift+Ctrl+M"
                          Command="{Binding RestoreAll}" />
                <Separator />
                <MenuItem Header="{loc:Tr AddToGlobal}" InputGesture="Ctrl+G"
                          Command="{Binding AddSelectedToGlobal}" IsEnabled="{Binding HasSelectedWindow}" />
                <MenuItem Header="{loc:Tr RemoveFromDesk}" InputGesture="Ctrl+D"
                          Command="{Binding RemoveSelectedFromDesk}" IsEnabled="{Binding HasSelectedWindow}" />
                <Separator />
                <MenuItem Header="{loc:Tr Minimize}" InputGesture="Ctrl+E"
                          Command="{Binding MinimizeSelected}" IsEnabled="{Binding CanMinimizeSelected}" />
                <MenuItem Header="{loc:Tr Restore}" InputGesture="Shift+Ctrl+E"
                          Command="{Binding RestoreSelected}" IsEnabled="{Binding CanRestoreSelected}" />
                <MenuItem Header="{loc:Tr Lower}" Command="{Binding LowerSelected}"
                          IsEnabled="{Binding HasSelectedWindow}" />
                <MenuItem Header="{loc:Tr Raise}" Command="{Binding RaiseSelected}"
                          IsEnabled="{Binding HasSelectedWindow}" />
            </MenuItem>
            <MenuItem Header="{loc:Tr MenuHelp}" DockPanel.Dock="Right">
                <MenuItem Header="{loc:Tr HelpProductInfo}" Click="OnProductInformation" />
            </MenuItem>
        </wlrix:MenuBar>

        <!-- Desk strip: pinned Global tile + horizontally scrolling desk list -->
        <DockPanel Margin="8">
            <ContentControl
                            Content="{Binding GlobalDesk}"
                            ContentTemplate="{StaticResource DeskTile}"
                            IsVisible="{Binding ShowGlobalDesk}"
                            VerticalAlignment="Top"
                            Margin="0,0,8,0" />

            <ListBox x:Name="DeskList"
                     ItemsSource="{Binding Desks}"
                     SelectedItem="{Binding SelectedDesk}"
                     ItemTemplate="{StaticResource DeskTile}"
                     PointerPressed="OnDeskListPointerPressed"
                     DoubleTapped="OnDeskDoubleTapped"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <!-- Fill a column top-to-bottom, then wrap to the next column; the viewport
                     height (vertical scrolling is disabled) bounds each column, and columns
                     overflow horizontally. -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>
    </DockPanel>

</Window>
