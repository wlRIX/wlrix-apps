<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.Settings.Utilities.ViewModels"
        xmlns:loc="using:Wlrix.Common.Localization"
        x:Class="Wlrix.Settings.Utilities.Views.ApplicationChooser"
        Width="360" Height="440" MinWidth="280" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Tr ChooserTitle}">

    <!-- Every installed application, for a menu's Other… and a type's Add…: a filter, the list,
         and OK and Cancel. A double-click is OK. -->
    <DockPanel Margin="10">
        <TextBox x:Name="Filter" DockPanel.Dock="Top" PlaceholderText="{loc:Tr FilterHint}" Margin="0,0,0,6"
                 TextChanged="OnFilterChanged" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,0">
            <Button x:Name="Accept" Content="{loc:Tr Ok}" MinWidth="80" Click="OnOk" IsDefault="True" IsEnabled="False" />
            <Button Content="{loc:Tr Cancel}" MinWidth="80" Click="OnCancel" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="List" SelectionChanged="OnSelectionChanged" DoubleTapped="OnDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AppChoice">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Source="{Binding Icon}" Width="16" Height="16" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
