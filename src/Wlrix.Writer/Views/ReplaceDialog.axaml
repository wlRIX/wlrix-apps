<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.Writer.ViewModels"
        xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
        xmlns:loc="using:Wlrix.Common.Localization"
        x:Class="Wlrix.Writer.Views.ReplaceDialog"
        x:DataType="vm:ReplaceViewModel"
        Title="{loc:Tr ReplaceTitle}"
        Width="430"
        CanResize="False"
        SizeToContent="Height"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WlrixFace}"
        Foreground="{DynamicResource WlrixForeground}"
        FontFamily="{DynamicResource WlrixFontFamily}"
        FontSize="12">
    <!-- NEdit's Replace/Find dialog, laid out as it was, with "Replace all in" scoped to tabs:
         Window became Tab and Multiple Files became All Tabs. Modeless, like Find. -->
    <wlrix:BevelBorder Bevel="Raised" BevelThickness="2" OuterLineThickness="1"
                       Background="{DynamicResource WlrixFace}"
                       LightBrush="{DynamicResource WlrixTopShadow}"
                       DarkBrush="{DynamicResource WlrixBottomShadow}"
                       OuterLineBrush="{DynamicResource WlrixOuterLine}"
                       Padding="10,8">
        <StackPanel Spacing="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontWeight="Bold" Text="{loc:Tr FindRecallHint}" />
                <AccessText FontWeight="Bold" Text="{loc:Tr FindLabel}" />
            </DockPanel>
            <TextBox Name="Field" Text="{Binding SearchText}" />

            <AccessText FontWeight="Bold" Text="{loc:Tr ReplaceWithLabel}" Margin="0,4,0,0" />
            <TextBox Name="ReplaceField" Text="{Binding ReplaceText}" />

            <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" Margin="0,2,0,0">
                <CheckBox Grid.Row="0" Grid.Column="0" Content="{loc:Tr FindRegex}"
                          IsChecked="{Binding RegularExpression}" />
                <CheckBox Grid.Row="0" Grid.Column="1" Content="{loc:Tr FindCase}"
                          IsChecked="{Binding CaseSensitive}" />
                <!-- W_hole Word in both dialogs: Alt+W belongs to Replace With here. -->
                <CheckBox Grid.Row="0" Grid.Column="2" Content="{loc:Tr FindWholeWord}"
                          IsChecked="{Binding WholeWord}" />
                <CheckBox Grid.Row="1" Grid.Column="0" Content="{loc:Tr FindBackward}"
                          IsChecked="{Binding SearchBackward}" />
                <CheckBox Grid.Row="1" Grid.Column="2" Content="{loc:Tr FindKeep}"
                          IsChecked="{Binding KeepDialog}" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <TextBlock FontWeight="Bold" Text="{loc:Tr ReplaceAllIn}" VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <Button Name="AllInTab" Content="{loc:Tr ReplaceScopeTab}" MinWidth="76"
                        IsEnabled="{Binding CanSearch}" />
                <Button Name="AllInSelection" Content="{loc:Tr ReplaceScopeSelection}" MinWidth="76"
                        IsEnabled="{Binding CanReplaceInSelection}" />
                <Button Name="AllInTabs" Content="{loc:Tr ReplaceScopeAllTabs}" MinWidth="76"
                        IsEnabled="{Binding CanReplaceInAllTabs}" />
            </StackPanel>

            <TextBlock Text="{Binding Message}" FontStyle="Italic" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                <Button Name="ReplaceButton" Grid.Column="0" Content="{loc:Tr ReplaceButton}"
                        MinWidth="72" IsDefault="True" IsEnabled="{Binding CanSearch}" />
                <Button Name="FindButton" Grid.Column="1" Content="{loc:Tr ReplaceFindButton}"
                        MinWidth="64" IsEnabled="{Binding CanSearch}" />
                <Button Name="ReplaceAndFindButton" Grid.Column="2" Content="{loc:Tr ReplaceAndFindButton}"
                        IsEnabled="{Binding CanSearch}" />
                <Button Name="CancelButton" Grid.Column="3" Content="{loc:Tr DialogCancel}"
                        MinWidth="72" IsCancel="True" />
            </Grid>
        </StackPanel>
    </wlrix:BevelBorder>
</Window>
