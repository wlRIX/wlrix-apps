<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Wlrix.Avalonia themes ListBox and not ItemsControl, and a control it does not cover has
         no template at all: it renders as nothing, with no error. AvaloniaEdit's TextArea hosts
         its left margins (the line numbers among them) in an ItemsControl, so without this
         Show Line Numbers turns on and draws nothing. The same theme Wlrix.Files carries. -->
    <ControlTheme x:Key="{x:Type ItemsControl}" TargetType="ItemsControl">
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
