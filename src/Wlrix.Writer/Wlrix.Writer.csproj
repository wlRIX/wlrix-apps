<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-writer</AssemblyName>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- Not compiled or copied: the desktop entry is installed by the Justfile, not by the
             build. Listed so it is visible in the IDE rather than an orphan directory. -->
        <None Include="data\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- The two highlighting palettes. Templates rather than finished themes: the default
             foreground and background are filled in from the session's color scheme at run time,
             see WriterTheme. -->
        <EmbeddedResource Include="Themes\*.json" LogicalName="Themes.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wlrix.Writer.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia.Dialogs" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="ZLogger" />
    </ItemGroup>

    <ItemGroup>
        <!-- The editing surface and its highlighting. See Directory.Packages.props. -->
        <PackageReference Include="Avalonia.AvaloniaEdit" />
        <PackageReference Include="AvaloniaEdit.TextMate" />
        <PackageReference Include="TextMateSharp" />
        <PackageReference Include="TextMateSharp.Grammars" />
        <!-- The Markdown preview's parser. -->
        <PackageReference Include="Markdig" />
    </ItemGroup>

    <ItemGroup>
        <!-- The single-instance guard: a second launch hands its files to the running window
             over the session bus. The same arrangement as Wlrix.Files. -->
        <PackageReference Include="Tmds.DBus.Protocol" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wlrix.Common\Wlrix.Common.csproj" />
        <!-- The SVG preview: resvg, as the icon theme draws with, and the namespace fix the
             IRIX-era exports need before it will read them. -->
        <ProjectReference Include="..\Wlrix.Icons\Wlrix.Icons.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Follows the session's color scheme, so the text area matches the desktop behind
             it. One call in App.axaml.cs. -->
        <ProjectReference Include="../Wlrix.Theme/Wlrix.Theme.csproj" />
    </ItemGroup>

</Project>
