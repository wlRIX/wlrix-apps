<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<!--
    The Secret Service, trimmed to what saving and recalling a share password needs.

    Taken from the live introspection of org.freedesktop.secrets, which busctl prints given
    the bus name, an object path, its user switch and its xml-interface switch. Spelled out
    rather than pasted as a command line because a double dash cannot appear inside an XML
    comment, and one that does breaks the whole file at build time as a DBUS1004 naming no
    line of C#. The same character has now broken three files in this workspace.

    Trimmed hard, and the omissions are the point. CreateCollection, SetAlias, Lock,
    LockService and ChangeLock are all ways for a file manager to make a mess of somebody's
    keyring; Item.SetSecret would let it rewrite a password another application owns. None of
    that belongs behind a Connect dialog. Signatures are copied unchanged, so the generated
    proxy cannot disagree with the daemon about one.

    org.freedesktop.Secret.Prompt is deliberately absent. Every method here answers with a
    prompt path, and this backend treats anything but "/" as "cannot do that without asking a
    question I have no way to ask": driving a prompt means handing gcr-prompter a window
    handle, and Avalonia cannot export one a foreign toolkit could import. The collection is
    unlocked at login by pam_gnome_keyring in wlrix-greeter's own PAM stack, so the prompt
    path is the unusual one, and the store falls back to holding passwords in memory when it
    is reached.
-->
<node>
  <interface name="org.freedesktop.Secret.Service">
    <method name="OpenSession">
      <arg type="s" name="algorithm" direction="in"/>
      <arg type="v" name="input" direction="in"/>
      <arg type="v" name="output" direction="out"/>
      <arg type="o" name="result" direction="out"/>
    </method>
    <method name="SearchItems">
      <arg type="a{ss}" name="attributes" direction="in"/>
      <arg type="ao" name="unlocked" direction="out"/>
      <arg type="ao" name="locked" direction="out"/>
    </method>
    <method name="ReadAlias">
      <arg type="s" name="name" direction="in"/>
      <arg type="o" name="collection" direction="out"/>
    </method>
  </interface>

  <interface name="org.freedesktop.Secret.Collection">
    <method name="CreateItem">
      <arg type="a{sv}" name="properties" direction="in"/>
      <arg type="(oayays)" name="secret" direction="in"/>
      <arg type="b" name="replace" direction="in"/>
      <arg type="o" name="item" direction="out"/>
      <arg type="o" name="prompt" direction="out"/>
    </method>
    <property type="b" name="Locked" access="read"/>
  </interface>

  <interface name="org.freedesktop.Secret.Item">
    <method name="Delete">
      <arg type="o" name="prompt" direction="out"/>
    </method>
    <method name="GetSecret">
      <arg type="o" name="session" direction="in"/>
      <arg type="(oayays)" name="secret" direction="out"/>
    </method>
    <property type="b" name="Locked" access="read"/>
    <property type="a{ss}" name="Attributes" access="read"/>
  </interface>
</node>
