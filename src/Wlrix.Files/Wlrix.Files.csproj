<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- The generated udisks2 proxy is `unsafe`-free, but Tmds.DBus.Protocol's readers and
             writers are spans over the raw message buffer and the generator emits code that
             uses them directly. No hand-written unsafe code here. Same arrangement as
             Wlrix.Shutdown and Wlrix.Settings.Client. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-files</AssemblyName>
        <Version>0.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- Not compiled or copied: the desktop entry is installed by the Justfile, not by
             the build. Listed so it is visible in the IDE rather than an orphan directory. -->
        <None Include="data\**" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wlrix.Files.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia.Dialogs" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="ZLogger" />
        <!-- The single-instance guard serves org.freedesktop.Application. Already in the
             output through Avalonia.Wayland -> Avalonia.FreeDesktop; referenced explicitly so
             NuGet does not resolve a second, differently-versioned copy. -->
        <PackageReference Include="Tmds.DBus.Protocol" />
        <PackageReference Include="Tomlyn" />
        <PackageReference Include="Tmds.DBus.Generator" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wlrix.Common\Wlrix.Common.csproj" />
        <ProjectReference Include="..\Wlrix.Files.Core\Wlrix.Files.Core.csproj" />
        <ProjectReference Include="..\Wlrix.Settings.Client\Wlrix.Settings.Client.csproj" />
        <!-- Follows the session's color scheme, so this window is the same gray as the
             desktop behind it and stays that way when somebody changes it. -->
        <ProjectReference Include="..\Wlrix.Theme\Wlrix.Theme.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- udisks2's own introspection, trimmed. The header of the XML says how to
             regenerate it and why it is not the whole thing. -->
        <AdditionalFiles Include="DBusXml/org.freedesktop.UDisks2.xml"
                         Namespace="Wlrix.Files.DBus"
                         DBusGeneratorMode="Proxy" />
    </ItemGroup>

</Project>
