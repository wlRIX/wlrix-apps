<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Wlrix.Common.Localization"
             xmlns:vm="using:Wlrix.Files.ViewModels"
             xmlns:controls="using:Wlrix.Files.Controls"
             x:Class="Wlrix.Files.Views.ListingView"
             x:DataType="vm:PaneViewModel">

    <!-- One tab's listing: the icon grid and the details table, one of which is showing.

         Its own control, and its data context is the tab rather than the window, because
         the tab strip gives each tab one of these. Everything it needs from the window it
         reaches through Tab.Window: the icon renderer, the drop policy and the operations.

         The places rail is deliberately not in here. It belongs to the window, not to a
         tab, and the file picker wants the rail beside a listing with no tabs at all. -->

    <UserControl.Styles>
        <!-- What hover and selection look like in the icon view: IRIX's file manager showed both
             on the icon, not the label, by the rule the desktop and the login screen follow
             (IconStatePainter). A type icon's light body is stippled at rest, white under the
             pointer and yellow when selected; the row carries all three renders and these pick
             one, so moving the pointer costs no render at all.

             Selection wins over hover by coming later: a selected cell under the pointer stays
             yellow rather than flicking to white. Every visibility here is set by a style and
             none in the template, because a local value would beat all of them. -->
        <Style Selector="Image.state.hover, Image.state.selected">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Image.state.rest">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Image.state.hover">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ListBoxItem:selected Image.state.rest, ListBoxItem:selected Image.state.hover">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBoxItem:selected Image.state.selected">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- A thumbnail is a picture of the file, not an icon, so it is never recolored: it is
             framed, as the login screen frames a user's own picture. One black pixel around it
             at rest; under the pointer or selected, two — that pixel and the picture's own
             outermost row — in white or yellow. The outer border is the first, the inner one
             overlaid on the picture's edge is the second. -->
        <Style Selector="Border#ThumbFrame">
            <Setter Property="BorderBrush" Value="{DynamicResource WlrixOuterLine}" />
        </Style>
        <Style Selector="Border#ThumbEdge">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Border#ThumbFrame, ListBoxItem:pointerover Border#ThumbEdge">
            <Setter Property="BorderBrush" Value="{DynamicResource WlrixIconTintHover}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border#ThumbFrame, ListBoxItem:selected Border#ThumbEdge">
            <Setter Property="BorderBrush" Value="{DynamicResource WlrixIconTintSelected}" />
        </Style>

        <!-- So the label is not highlighted, as it was not in IRIX's file manager. The theme's
             `ListBoxItem:selected TextBlock` (WlrixTheme.axaml) still repaints selected text in
             the color meant to sit *on* a highlight, and with no highlight behind it a chosen
             name would read as dimmed. This puts it back in the view's own color. -->
        <Style Selector="ListBoxItem:selected Border#Label TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WlrixViewForeground}" />
        </Style>

        <!-- The folder a drag is aimed at. Kept visually distinct from selection, because a
             drop usually lands on something that is not selected and both are on screen at
             once. The border is always there and only changes color, so a row does not
             shift by a pixel the moment a drag passes over it. -->
        <Style Selector="Border.dropTarget">
            <Setter Property="Background" Value="{DynamicResource WlrixSelection}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WlrixForeground}" />
        </Style>
        <Style Selector="Border.dropTarget TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WlrixSelectionForeground}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- One menu for both views, on the panel that holds them: a right-click anywhere in
             the listing finds it, including the empty space below the last row, which is where
             New Folder and Select All are wanted. What it can act on is decided when it opens,
             in OnContextMenuOpening. -->
        <Panel.ContextMenu>
            <ContextMenu Name="ListingMenu">
                <MenuItem Name="CtxOpen" Header="{loc:Tr ActionOpen}"
                          Command="{Binding Tab.Window.OpenSelection}" />
                <MenuItem Name="CtxOpenNewTab" Header="{loc:Tr ContextOpenNewTab}"
                          Command="{Binding Tab.Window.OpenSelectionInNewTab}" />
                <MenuItem Header="-" />
                <MenuItem Name="CtxTrash" Header="{loc:Tr SelectedTrash}"
                          Command="{Binding Tab.Window.TrashSelection}" />
                <MenuItem Name="CtxProperties" Header="{loc:Tr SelectedProperties}"
                          Command="{Binding Tab.Window.ShowProperties}" />
                <MenuItem Header="-" />
                <MenuItem Header="{loc:Tr ActionNewFolder}"
                          Command="{Binding Tab.Window.NewFolder}" />
                <MenuItem Header="{loc:Tr ContextSelectAll}"
                          Command="{Binding Tab.Window.SelectAll}" />
            </ContextMenu>
        </Panel.ContextMenu>

        <!-- The icon view, with the rubber-band overlay above it. The band is drawn in a
             Canvas rather than by the panel so it floats over the cells and does not take
             part in layout. -->
        <Panel IsVisible="{Binding IsIconView}">
        <ListBox Name="IconView"
                 ItemsSource="{Binding Entries}"
                 SelectionMode="Multiple"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingIconPanel CellWidth="96" CellHeight="104" CellGap="8" CellMargin="12" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <!-- The container fills its cell so the whole cell is a hit target, but
                         paints nothing: state shows on the icon itself. -->
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FileEntryViewModel">
                    <StackPanel Margin="0,6,0,0" Spacing="3">
                        <Panel Height="52">
                            <!-- The type icon, in whichever state the styles above pick.

                                 The three images are invisible to hit-testing and the panel
                                 around them takes the press, and that is load-bearing: Avalonia
                                 raises DoubleTapped only when both presses land on the *same*
                                 element. The first press on an unselected icon selects it, which
                                 swaps the hover image for the selected one, so with the images
                                 taking presses the second landed on a different element and a
                                 double-click on anything not already selected did nothing. -->
                            <Panel Width="48" Height="48"
                                   Background="Transparent"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ShowsIcon}">
                                <Image Classes="state rest" Source="{Binding IconRest}" IsHitTestVisible="False" />
                                <Image Classes="state hover" Source="{Binding IconHover}" IsHitTestVisible="False" />
                                <Image Classes="state selected" Source="{Binding IconSelected}" IsHitTestVisible="False" />
                            </Panel>
                            <!-- Or the file's own picture, framed. The frame hugs the picture
                                 rather than the 48px square, so a wide photograph is framed
                                 where it is drawn. -->
                            <Border Name="ThumbFrame"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasThumbnail}">
                                <Panel>
                                    <Image Source="{Binding Thumbnail}"
                                           MaxWidth="48" MaxHeight="48"
                                           Stretch="Uniform" />
                                    <Border Name="ThumbEdge" BorderThickness="1" />
                                </Panel>
                            </Border>
                            <!-- Shown until the type's icon has been rendered, so a cell is
                                 never visibly empty while resvg works. -->
                            <Path Width="48" Height="40" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M1,4 L1,3 L6,3 L7,4.5 L15,4.5 L15,13 L1,13 Z"
                                  Fill="{DynamicResource WlrixFace}"
                                  Stroke="{DynamicResource WlrixOuterLine}"
                                  StrokeThickness="1"
                                  IsVisible="{Binding ShowDirectoryGlyph}" />
                        </Panel>
                        <Border Name="Label"
                                HorizontalAlignment="Center"
                                Padding="3,1"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Classes.dropTarget="{Binding IsDropTarget}">
                            <TextBlock Text="{Binding DisplayName}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="88"
                                       MaxLines="2" />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

            <Canvas Name="BandLayer" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle Name="Band"
                           IsVisible="False"
                           Fill="{DynamicResource WlrixSelection}"
                           Opacity="0.3"
                           Stroke="{DynamicResource WlrixSelection}"
                           StrokeThickness="1" />
            </Canvas>
        </Panel>

        <!-- The details view. TableView virtualizes through the VirtualizingStackPanel it
             inherits from ListBox, which is what makes a very large directory usable. -->
        <TableView
                   Name="Listing"
                   IsVisible="{Binding IsDetailsView}"
                   ItemsSource="{Binding Entries}"
                   SelectionMode="Multiple"
                   CanUserResizeColumns="True">
            <TableView.Columns>
                <TableViewColumn Header="{loc:Tr ColumnName}" Width="*">
                    <TableViewColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FileEntryViewModel">
                          <Border BorderThickness="1"
                                  BorderBrush="Transparent"
                                  Background="Transparent"
                                  Classes.dropTarget="{Binding IsDropTarget}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <!-- Placeholder geometry, matching Wlrix.Archiver's. Real
                                     icons arrive with the icon-theme resolver, at which
                                     point these two Paths become an Image. Drawn rather
                                     than themed so a folder still reads as a folder in
                                     every color scheme. -->
                                <Image Source="{Binding Preview}" Width="16" Height="16"
                                       VerticalAlignment="Center" />
                                <Path Width="16" Height="16" Stretch="None"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding ShowDirectoryGlyph}"
                                      Data="M1,4 L1,3 L6,3 L7,4.5 L15,4.5 L15,13 L1,13 Z"
                                      Fill="{DynamicResource WlrixFace}"
                                      Stroke="{DynamicResource WlrixOuterLine}"
                                      StrokeThickness="1" />
                                <Path Width="16" Height="16" Stretch="None"
                                      VerticalAlignment="Center"
                                      Data="M3,1 L10,1 L13,4 L13,15 L3,15 Z M10,1 L10,4 L13,4"
                                      Fill="{DynamicResource WlrixTopShadow}"
                                      Stroke="{DynamicResource WlrixOuterLine}"
                                      StrokeThickness="1"
                                      IsVisible="{Binding ShowFileGlyph}" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                    </TableViewColumn.CellTemplate>
                </TableViewColumn>
                <TableViewColumn Header="{loc:Tr ColumnSize}" Width="110"
                                 HorizontalContentAlignment="Right" Binding="{Binding SizeText}" />
                <TableViewColumn Header="{loc:Tr ColumnKind}" Width="90" Binding="{Binding KindText}" />
                <TableViewColumn Header="{loc:Tr ColumnModified}" Width="150" Binding="{Binding ModifiedText}" />
            </TableView.Columns>
        </TableView>
    </Panel>
</UserControl>
