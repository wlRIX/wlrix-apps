<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-settings-background</AssemblyName>
        <Version>0.0.0</Version>
        <!-- NWayland's generated bindings and runtime interop are unsafe. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- The wlrix-desks bindings, for the desk option menu: a desk's own background is kept by
         the compositor and set over that protocol. Generated at build time by the wlRIX
         NWayland fork's source generator from wlrix-protocols, as in Wlrix.Desks. -->
    <ItemGroup>
        <AdditionalFiles Include="../../../NWayland/external/wlrix-protocols/wlrix-desks.xml"
                         NWaylandNamespace="NWayland.Protocols" />
    </ItemGroup>
    <PropertyGroup>
        <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591;CS1573;CS1572;CS1570;CS1571;CS1574;CS1580;CS1581;CS1584</WarningsNotAsErrors>
    </PropertyGroup>
    <Import Project="../../../NWayland/src/NWayland.Generator/NWayland.Generator.Use.targets" />

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- The .desktop entry and the icon, installed by the Justfile's install-desktop rather
             than built. Listed so they are visible in the IDE rather than an orphan directory. -->
        <None Include="data\**" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wlrix.Settings.Background.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia" />
        <!-- The IRIX message window, for the Help item. -->
        <PackageReference Include="Wlrix.Avalonia.Dialogs" />
        <!-- IRIX's Color Browser, for the desktop color. -->
        <PackageReference Include="Wlrix.Avalonia.Controls.ColorPicker" />
        <!-- NWayland runtime, pinned in Directory.Packages.props to the version Avalonia.Wayland
             binds to. -->
        <PackageReference Include="NWayland" />
    </ItemGroup>

    <ItemGroup>
        <!-- The localized strings and the {loc:Tr} markup extension, and the SGI decoder the
             thumbnails of IRIX's own backgrounds need. -->
        <ProjectReference Include="../Wlrix.Common/Wlrix.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The only way this panel touches a config file: `background.*`, and `lock.background.*`
             when the lock screen follows the desktop. -->
        <ProjectReference Include="../Wlrix.Settings.Client/Wlrix.Settings.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Follows the session's color scheme. One call in App.axaml.cs. -->
        <ProjectReference Include="../Wlrix.Theme/Wlrix.Theme.csproj" />
    </ItemGroup>

</Project>
