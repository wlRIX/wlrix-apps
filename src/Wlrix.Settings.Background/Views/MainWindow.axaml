<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.Settings.Background.ViewModels"
        xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
        xmlns:loc="using:Wlrix.Common.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
        Width="520" Height="560" MinWidth="420" MinHeight="440"
        x:Class="Wlrix.Settings.Background.Views.MainWindow"
        x:DataType="vm:BackgroundViewModel"
        Title="{loc:Tr WindowTitle}">

    <Design.DataContext>
        <vm:BackgroundViewModel />
    </Design.DataContext>

    <!-- The layout follows IRIX's Background panel: a menu bar, a title banner, the pictures in
         a scrolled well, the desktop color beside them, then the buttons along the bottom.
         IRIX's Desk option menu is absent: wlRIX has one background for every desk so far. -->
    <DockPanel LastChildFill="True">

        <wlrix:MenuBar DockPanel.Dock="Top">
            <MenuItem Header="{loc:Tr MenuApplication}">
                <MenuItem Header="{loc:Tr MenuClose}" Click="OnCancel" />
            </MenuItem>
            <MenuItem Header="{loc:Tr MenuHelp}" DockPanel.Dock="Right">
                <MenuItem Header="{loc:Tr MenuClickForHelp}" Click="OnHelp" />
            </MenuItem>
        </wlrix:MenuBar>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12"
                    Margin="12,12,12,10">
            <Border Width="48" Height="48"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource WlrixOuterLine}"
                    Background="{DynamicResource WlrixSelect}">
                <!-- Placeholder for the panel icon, as in the other panels' banners. -->
                <TextBlock Text="&#x1F5BC;" FontSize="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{loc:Tr PanelTitle}" FontWeight="Bold" FontSize="16"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="10" Margin="12,10,12,12">
            <Button Content="{loc:Tr Ok}" MinWidth="92" Click="OnOk" />
            <Button Content="{loc:Tr Reset}" MinWidth="92" Click="OnReset"
                    IsEnabled="{Binding IsReady}" />
            <Button Content="{loc:Tr Cancel}" MinWidth="92" Click="OnCancel" />
        </StackPanel>

        <!-- Whatever the last change had to say for itself, when it had anything. -->
        <TextBlock DockPanel.Dock="Bottom" Margin="12,0,12,0" TextWrapping="Wrap"
                   Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,0" Spacing="8">
            <Grid ColumnDefinitions="Auto,8,*,16,Auto,8,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Tr Fit}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Modes}"
                          SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                          IsEnabled="{Binding CanFit}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModeChoice">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="4" Text="{loc:Tr DesktopColor}" VerticalAlignment="Center" />
                <Button Grid.Column="6" Click="OnColor" IsEnabled="{Binding IsReady}"
                        Padding="4">
                    <Border Width="40" Height="16" BorderThickness="1"
                            BorderBrush="{DynamicResource WlrixOuterLine}"
                            Background="{Binding ColorBrush}" />
                </Button>
            </Grid>
            <CheckBox Content="{loc:Tr AlsoLockScreen}"
                      IsChecked="{Binding AlsoLockScreen, Mode=TwoWay}"
                      IsEnabled="{Binding IsReady}" />
        </StackPanel>

        <DockPanel Margin="12,0,12,0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Pictures}" Margin="0,0,0,3" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                        Margin="0,6,0,0">
                <Button Content="{loc:Tr Add}" MinWidth="80" Click="OnAdd" />
                <Button Content="{loc:Tr Remove}" MinWidth="80" Click="OnRemove"
                        IsEnabled="{Binding CanRemove}" />
                <TextBlock Text="{loc:Tr DropHint}" VerticalAlignment="Center" Opacity="0.75" />
            </StackPanel>

            <!-- The well the pictures sit in, which also takes image icons dropped from Files
                 or the desktop. -->
            <ListBox x:Name="PictureList"
                     ItemsSource="{Binding Pictures}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     DragDrop.AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:WallpaperTile">
                        <StackPanel Width="104" Spacing="3" Margin="2">
                            <!-- The desktop color behind every thumbnail, as it will be behind
                                 the picture, so a transparent one and "No Picture" both show
                                 what the desktop would. -->
                            <Border Width="100" Height="75" BorderThickness="1"
                                    BorderBrush="{DynamicResource WlrixOuterLine}"
                                    Background="{Binding $parent[ListBox].((vm:BackgroundViewModel)DataContext).ColorBrush}"
                                    ClipToBounds="True">
                                <Panel>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    <TextBlock Text="&#x1F5BC;" FontSize="28"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding ShowsGlyph}" />
                                </Panel>
                            </Border>
                            <TextBlock Text="{Binding Name}" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

    </DockPanel>

</Window>
