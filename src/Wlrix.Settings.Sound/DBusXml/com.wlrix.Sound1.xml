<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="com.wlrix.Sound1">
    <method name="Play">
      <arg name="name" type="s" direction="in"/>
    </method>
    <method name="Preview">
      <arg name="theme" type="s" direction="in"/>
      <arg name="name" type="s" direction="in"/>
    </method>
    <method name="Events">
      <arg name="events" type="a(sss)" direction="out"/>
    </method>
    <method name="ListThemes">
      <arg name="themes" type="a(ss)" direction="out"/>
    </method>
  </interface>
</node>
