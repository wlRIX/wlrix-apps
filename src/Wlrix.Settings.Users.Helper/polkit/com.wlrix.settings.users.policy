<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<!--
    The polkit action behind User Accounts' privileged half, wlrix-users-helper.

    It changes the PAM stacks of sudo and of polkit itself, so that a fingerprint is accepted in
    place of the password for everyone on the machine with a finger enrolled. auth_admin rather
    than auth_admin_keep: this is how the machine checks who may become root, and each change to
    it should be asked for.

    Installed to $PREFIX/share/polkit-1/actions/.
-->
<policyconfig>

    <vendor>wlRIX</vendor>
    <vendor_url>https://github.com/wlRIX</vendor_url>

    <action id="com.wlrix.settings.users.fingerprint">
        <description>Choose where a fingerprint is accepted</description>
        <message>Authentication is required to change where a fingerprint can be used in place of a password.</message>
        <defaults>
            <allow_any>auth_admin</allow_any>
            <allow_inactive>auth_admin</allow_inactive>
            <allow_active>auth_admin</allow_active>
        </defaults>
        <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/wlrix-users-helper</annotate>
    </action>

</policyconfig>
