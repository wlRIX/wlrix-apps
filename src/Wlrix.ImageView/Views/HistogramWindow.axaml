<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.ImageView.ViewModels"
        xmlns:controls="using:Wlrix.ImageView.Controls"
        xmlns:loc="using:Wlrix.Common.Localization"
        xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
        x:Class="Wlrix.ImageView.Views.HistogramWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{loc:Tr HistogramTitle}"
        Width="420" Height="340" MinWidth="300" MinHeight="260">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <TextBlock Text="{loc:Tr HistogramChannel}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Histogram.ChannelNames}"
                      SelectedIndex="{Binding Histogram.ChannelIndex}" MinWidth="120" />
        </StackPanel>

        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" MinWidth="80"
                Margin="0,8,0,0" Content="{loc:Tr Close}" Click="OnClose" />

        <!-- The figures for the channel shown. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0"
              ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto">
            <Grid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Margin" Value="0,1,6,1" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Styles>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr HistogramMin}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Histogram.MinText}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Tr HistogramMax}" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Histogram.MaxText}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr HistogramMean}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Histogram.MeanText}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Tr HistogramMedian}" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Histogram.MedianText}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr HistogramPixels}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Histogram.PixelsText}" />
        </Grid>

        <!-- The graph sits in a sunken well on black, the way IRIX drew one. -->
        <wlrix:BevelBorder Bevel="Sunken" BevelThickness="2"
                           LightBrush="{DynamicResource WlrixTopShadow}"
                           DarkBrush="{DynamicResource WlrixBottomShadow}">
            <controls:HistogramGraph Histogram="{Binding Histogram.Histogram}"
                                     Channel="{Binding Histogram.Channel}"
                                     Background="Black" Foreground="White" />
        </wlrix:BevelBorder>
    </DockPanel>
</Window>
