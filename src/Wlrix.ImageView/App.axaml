<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
             x:Class="Wlrix.ImageView.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The palette's icons and button theme. The avares authority is the assembly
                     name (kebab-case), not the namespace. -->
                <ResourceInclude Source="avares://wlrix-imageview/Themes/ToolIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <wlrix:WlrixTheme />
    </Application.Styles>
</Application>
