[Desktop Entry]
Type=Application
Name=wlRIX ImageView
Name[ja]=wlRIX イメージビュー
GenericName=Image Viewer
GenericName[ja]=画像ビューア
Comment=View, turn and examine images
Comment[ja]=画像を表示・回転・調査します
Icon=com.wlrix.imageview
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;

# %f, not %F: the window holds one image at a time, and `App` opens `args[0]` only.
Exec=wlrix-imageview %f
TryExec=wlrix-imageview
Terminal=false

# The symbol while it is running, as IRIX's imgview had: the closed one puts a face on the magic
# carpet's picture, the running one shows it on the carpet stood upright. A wlRIX extension,
# read by wlrix-desktop and the icon catalog; the X- prefix keeps the file valid elsewhere.
X-WLRIX-Running-Icon=com.wlrix.imageview-running

# Matches the Wayland app id set in Program.BuildAvaloniaApp, which is how `wlrix-desktop`
# finds the running window.
StartupWMClass=com.wlrix.imageview
StartupNotify=false

# Only what the viewer can actually decode. image/x-sgi is the SGI format itself; image/x-rgb is
# what shared-mime-info calls a `.rgb` file, which on this desktop is overwhelmingly an SGI one.
# The app goes by the file's magic number either way.
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/x-bmp;image/x-icon;image/vnd.microsoft.icon;image/x-sgi;image/x-rgb;
