<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The tool palette's pictures, on a 20×20 grid. Geometry only, so they take the button's
         foreground and gray out with it when a button is disabled. The drawing is after the
         IRIX imgview palette: a hand, a turning arrow, a zoom frame, and so on down. -->

    <!-- An open hand, fingers up. Outlined and filled light, as the IRIX one was. -->
    <StreamGeometry x:Key="IconHand">M6,10.5 L6,5 C6,3.9 7.6,3.9 7.6,5 L7.6,9.5 L7.6,3.4 C7.6,2.3 9.2,2.3 9.2,3.4 L9.2,9.3 L9.2,3 C9.2,1.9 10.8,1.9 10.8,3 L10.8,9.4 L10.8,4.2 C10.8,3.1 12.4,3.1 12.4,4.2 L12.4,12 L14,10.2 C14.8,9.2 16.4,10 15.6,11.2 L12.6,15.8 C11.6,17.3 10.5,18 8.8,18 C7,18 6,16.9 6,15 Z</StreamGeometry>

    <!-- Three quarters of a circle and the arrowhead that turns it. -->
    <StreamGeometry x:Key="IconRotate">M15.5,10 A5.5,5.5 0 1 1 12.8,5.3</StreamGeometry>
    <StreamGeometry x:Key="IconRotateHead">M11.2,2.6 L16.4,4.4 L12.6,8.4 Z</StreamGeometry>

    <!-- A frame with a smaller one in its corner, and the arrow growing it. -->
    <StreamGeometry x:Key="IconZoom">M3,3 H17 V17 H3 Z M3,11 H9 V17 M8,12 L15,5 M10.5,5 H15 V9.5</StreamGeometry>

    <!-- An arrow that doubles back. -->
    <StreamGeometry x:Key="IconUndo">M7.5,4 L3.5,8 L7.5,12 M3.5,8 H12 C15,8 17,10 17,12.8 C17,15.6 15,17.5 12,17.5 H8</StreamGeometry>

    <!-- A wrench: adjustments. -->
    <StreamGeometry x:Key="IconProperties">M14.6,2.4 C12,2.4 10.4,4.7 11.1,7.1 L2.8,15.4 L4.6,17.2 L12.9,8.9 C15.3,9.6 17.6,8 17.6,5.4 L15.6,7.4 L13.3,6.7 L12.6,4.4 Z</StreamGeometry>

    <!-- A magnifying glass: the close-up of the pixels under the pointer. -->
    <StreamGeometry x:Key="IconDetail">M2.5,8.5 A5.5,5.5 0 1 1 13.5,8.5 A5.5,5.5 0 1 1 2.5,8.5 Z M12.4,12.4 L17.5,17.5</StreamGeometry>

    <!-- A mountain range, which is what a histogram looks like. -->
    <StreamGeometry x:Key="IconHistogram">M2,17.5 L6,9 L8.6,12.2 L12.2,3.5 L15.2,10.8 L18,17.5 Z</StreamGeometry>

    <!-- The information "i". -->
    <StreamGeometry x:Key="IconInfo">M8.5,4.2 A1.5,1.5 0 1 1 11.5,4.2 A1.5,1.5 0 1 1 8.5,4.2 Z M7.4,7.8 H11.4 V15.4 H12.8 V17.2 H7.2 V15.4 H8.6 V9.6 H7.4 Z</StreamGeometry>
</ResourceDictionary>
