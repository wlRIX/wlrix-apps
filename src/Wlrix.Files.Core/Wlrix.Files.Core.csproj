<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wlrix.Files.Core.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Deliberately no Avalonia reference of any kind. This library is what
             Wlrix.FilePicker — the FileChooser portal's dialog — is built on, and it is
             the only part of the file manager that CI can exercise with no display. Both
             stop being true the moment a UI type leaks in. -->
        <PackageReference Include="ZLogger" />
    </ItemGroup>

    <ItemGroup>
        <!-- files.toml, which this library parses because two programs read it: the file
             manager and the file chooser. A hand-rolled reader here would repeat the bug that
             created wlrix-settings-daemon in the first place. -->
        <PackageReference Include="Tomlyn" />
    </ItemGroup>

    <ItemGroup>
        <!-- Decoding icons and, later, thumbnails. Skia is already in every app's output
             through Avalonia; pinning the same version keeps it to one native library. -->
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
        <PackageReference Include="ResvgSharp" />
    </ItemGroup>

    <ItemGroup>
        <!-- The three remote protocols. Each is reached only through one IRemoteSession
             implementation, and nothing above that layer references these assemblies:
             the isolation invariant is that no library exception escapes a session. -->
        <PackageReference Include="SMBLibrary" />
        <PackageReference Include="FluentFTP" />
        <PackageReference Include="SSH.NET" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wlrix.Common\Wlrix.Common.csproj" />
    </ItemGroup>
</Project>
