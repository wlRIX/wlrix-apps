<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Wlrix.Clock.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="150" d:DesignHeight="150"
        x:Class="Wlrix.Clock.Views.ClockWindow"
        Width="150" Height="150"
        MinWidth="48" MinHeight="48"
        WindowDecorations="None"
        Title="Clock">

    <!-- The compositor gives this window a border and nothing else, by its app id (see
         placement::shell_frame in wlrix-compositor), and that border is what resizes it.
         With no titlebar to grab, a left drag anywhere on the face moves the window instead.

         WindowDecorations="None" is for every other compositor: it asks for no titlebar and
         keeps Avalonia from drawing one of its own. Under wlrix-compositor the rule decides. -->

    <controls:ClockFace x:Name="Face"
                        PointerPressed="OnFacePressed" />

</Window>
