<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<!--
    fprintd's interfaces, trimmed to the members the Fingerprints dialog uses.

    Signatures as fprintd 1.94 documents them in its net.reactivated.Fprint.Manager.xml and
    net.reactivated.Fprint.Device.xml (not installed on the machine this was written on, which
    has no reader). Finger names are fprintd's own: "left-thumb" ... "right-little-finger".
-->

<node>
  <interface name="net.reactivated.Fprint.Manager">
    <method name="GetDevices">
      <arg name="devices" direction="out" type="ao"/>
    </method>
    <method name="GetDefaultDevice">
      <arg name="device" direction="out" type="o"/>
    </method>
  </interface>

  <interface name="net.reactivated.Fprint.Device">
    <method name="Claim">
      <arg name="username" direction="in" type="s"/>
    </method>
    <method name="Release"/>
    <method name="ListEnrolledFingers">
      <arg name="username" direction="in" type="s"/>
      <arg name="enrolled_fingers" direction="out" type="as"/>
    </method>
    <method name="DeleteEnrolledFinger">
      <arg name="finger_name" direction="in" type="s"/>
    </method>
    <method name="DeleteEnrolledFingers2"/>
    <method name="EnrollStart">
      <arg name="finger_name" direction="in" type="s"/>
    </method>
    <method name="EnrollStop"/>
    <signal name="EnrollStatus">
      <arg name="result" type="s"/>
      <arg name="done" type="b"/>
    </signal>
    <property name="name" type="s" access="read"/>
    <property name="num-enroll-stages" type="i" access="read"/>
    <property name="scan-type" type="s" access="read"/>
  </interface>
</node>
