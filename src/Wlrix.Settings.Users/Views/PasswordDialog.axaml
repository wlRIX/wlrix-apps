<views:PasswordDialogBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wlrix.Settings.Users.ViewModels"
        xmlns:views="using:Wlrix.Settings.Users.Views"
        xmlns:loc="using:Wlrix.Common.Localization"
        x:Class="Wlrix.Settings.Users.Views.PasswordDialog"
        x:DataType="vm:PasswordModel"
        Width="420"
        Title="{loc:Tr PasswordTitle}">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="Heading" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Text="{loc:Tr NewPassword}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="First" Text="{Binding Password}" PasswordChar="{Binding MaskChar}" />
            <TextBlock Grid.Row="1" Text="{loc:Tr ConfirmPassword}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Confirm}" PasswordChar="{Binding MaskChar}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PasswordProblem}" TextWrapping="Wrap"
                       IsVisible="{Binding PasswordProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <CheckBox Grid.Row="3" Grid.Column="1" Content="{loc:Tr ShowPassword}" IsChecked="{Binding ShowPassword}" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{loc:Tr Cancel}" MinWidth="92" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr SetPassword}" MinWidth="92" Click="OnOk" IsDefault="True"
                    IsEnabled="{Binding CanFinish}" />
        </StackPanel>
    </StackPanel>
</views:PasswordDialogBase>
