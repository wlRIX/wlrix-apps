<views:DeleteDialogBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Wlrix.Settings.Users.Views"
        xmlns:loc="using:Wlrix.Common.Localization"
        x:Class="Wlrix.Settings.Users.Views.DeleteDialog"
        Width="440"
        Title="{loc:Tr DeleteTitle}">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="Question" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
        <CheckBox x:Name="Files" />
        <TextBlock Text="{loc:Tr DeleteFilesNote}" TextWrapping="Wrap" Margin="24,0,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{loc:Tr Cancel}" MinWidth="92" Click="OnCancel" IsCancel="True" IsDefault="True" />
            <Button Content="{loc:Tr Delete}" MinWidth="92" Click="OnDelete" />
        </StackPanel>
    </StackPanel>
</views:DeleteDialogBase>
