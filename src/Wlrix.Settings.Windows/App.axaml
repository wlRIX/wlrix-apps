<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wlrix="https://vic485.xyz/Wlrix.Avalonia"
             x:Class="Wlrix.Settings.Windows.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <wlrix:WlrixTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The controls WlrixTheme does not cover. `avares://` takes the *assembly*
                     name, which is wlrix-settings-windows, not the project name. -->
                <ResourceInclude Source="avares://wlrix-settings-windows/Themes/Panel.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
