<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-clipboard-history</AssemblyName>
        <Version>0.1.0</Version>
        <!-- The generated proxy is `unsafe`-free, but Tmds.DBus.Protocol's readers and writers
             are spans over the raw message buffer, and the generator emits code that uses them
             directly. No hand-written unsafe code here. Same arrangement as
             Wlrix.Settings.Client. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wlrix.Common\Wlrix.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wlrix.ClipboardHistory.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The proxy comes from the daemon's own introspection, so the two cannot disagree
             about a signature. The history lives in wlrix-clipboard; this app only shows it. -->
        <AdditionalFiles Include="DBusXml/com.wlrix.Clipboard1.xml"
                         Namespace="Wlrix.ClipboardHistory.DBus"
                         DBusGeneratorMode="Proxy" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Tmds.DBus.Protocol" />
        <PackageReference Include="Tmds.DBus.Generator" PrivateAssets="all" />
        <PackageReference Include="Wlrix.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia.Dialogs" />
    </ItemGroup>

    <ItemGroup>
        <!-- Follows the session's color scheme, so this window is the same gray as the desktop
             behind it and stays that way when somebody changes it. One call in App.axaml.cs. -->
        <ProjectReference Include="../Wlrix.Theme/Wlrix.Theme.csproj" />
    </ItemGroup>

</Project>
