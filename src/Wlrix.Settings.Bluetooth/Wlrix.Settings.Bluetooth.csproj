<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>wlrix-settings-bluetooth</AssemblyName>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- The banner picture; see tools/panel-banners.py. -->
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Wlrix.Settings.Bluetooth.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Proxies for the members of BlueZ this panel calls; the header of the XML says where
             they came from. -->
        <AdditionalFiles Include="DBusXml/org.bluez.xml"
                         Namespace="Wlrix.Settings.Bluetooth.DBus"
                         DBusGeneratorMode="Proxy" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Wayland" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" />
        <PackageReference Include="Tmds.DBus.Protocol" />
        <PackageReference Include="Tmds.DBus.Generator" PrivateAssets="all" />
        <PackageReference Include="Wlrix.Avalonia" />
        <PackageReference Include="Wlrix.Avalonia.Dialogs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Wlrix.Common/Wlrix.Common.csproj" />
        <!-- The one wlRIX setting here, the tray icon, lives in bluetooth.toml and goes through
             wlrix-settings-daemon like every other panel's. Everything else is BlueZ's. -->
        <ProjectReference Include="../Wlrix.Settings.Client/Wlrix.Settings.Client.csproj" />
        <!-- Follows the session's color scheme. One call in App.axaml.cs. -->
        <ProjectReference Include="../Wlrix.Theme/Wlrix.Theme.csproj" />
    </ItemGroup>

</Project>
