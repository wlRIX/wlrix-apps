<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>wlrix-login-helper</AssemblyName>
        <Version>0.1.1</Version>
        <!-- Runs as root under pkexec. Nothing here should be a surprise at run time. -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <!-- The request, its validation and the file format are shared with the panel, so the
             two cannot disagree about what is allowed. -->
        <ProjectReference Include="..\Wlrix.Settings.Login.Core\Wlrix.Settings.Login.Core.csproj" />
    </ItemGroup>

</Project>
